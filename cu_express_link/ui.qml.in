import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Item {
    id: root
    anchors.fill: parent
    property var link: []
    property bool dirty: false
    property bool busy: false
    property double lastReply: 0
    property double sentAt: 0
    property string queued: ""
    property string operation: ""
    property string message: "Waiting for Express Link..."
    property var pendingValues: []
    property bool saveAck: false
    property bool stale: true

    function queue(command, kind) {
        if (busy || stale) return
        queued = command; operation = kind; busy = true; saveAck = false
        message = kind === "save" ? "Saving connection settings..." : "Forgetting screen..."
    }
    function save() {
        pendingValues = [automatic.checked ? 1 : 0, esc.value,
                         second.checked ? 1 : 0, esc2.value, channel.value]
        queue("(express-config-save " + pendingValues.join(" ") + ")", "save")
    }
    function tick() {
        var now = Date.now()
        stale = !lastReply || now - lastReply > 5000
        if (busy && !queued && now - sentAt > 6000) {
            busy = false; operation = ""; saveAck = false
            message = "No confirmation. Reconnect and read settings before trying again."
        }
        if (now - sentAt < 700 || (busy && !queued)) return
        var cmd = queued || "(express-status)"
        queued = ""; sentAt = now
        try { VescIf.commands().lispSendReplCmd(cmd) }
        catch (e) { busy = false; operation = ""; message = "Connection unavailable." }
    }
    function receive(text) {
        if (text.indexOf("EXLINK-SAVE:failed") >= 0) {
            busy = false; operation = ""; saveAck = false
            message = "Settings were not saved. Check controller IDs and reconnect before retrying."
            return
        }
        if (text.indexOf("EXLINK-SAVE:ok") >= 0 && operation === "save") saveAck = true
        if (text.indexOf("EXLINK-PAIR:") >= 0 && operation === "forget") {
            busy = false; operation = ""
            message = text.indexOf("EXLINK-PAIR:ok") >= 0 ? "Pairing cleared. Select this link on your screen."
                    : text.indexOf("EXLINK-PAIR:busy") >= 0 ? "Turn the paired screen off first."
                    : "Pairing was not cleared. Reconnect and try again."
        }
        var start = text.indexOf("EXLINK:")
        if (start < 0) return
        var fields = text.substring(start + 7).trim().split(",")
        if (fields.length !== 13) return
        var v = fields.map(Number)
        if (v.some(function(n) { return !isFinite(n) || Math.floor(n) !== n }) || v[0] !== 1) return
        if ([1,3,6,7,8,10].some(function(i) { return v[i] !== 0 && v[i] !== 1 }) ||
            v[2] < 0 || v[2] > 253 || v[4] < 0 || v[4] > 253 ||
            v[5] < 1 || v[5] > 13 || v[9] < 0 || v[9] > 253 ||
            v[11] < 0 || v[11] > 253 || v[12] < 0 || v[12] > 13) return
        var first = !lastReply
        link = v; lastReply = Date.now(); stale = false
        if (operation === "save" && saveAck) {
            var matches = pendingValues.every(function(n, i) { return n === v[i + 1] })
            busy = false; operation = ""; saveAck = false
            if (matches) { dirty = false; message = "Saved and verified. Power-cycle the Express T to apply." }
            else message = "Stored values did not match. Read settings before trying again."
        }
        if (!dirty && !busy) {
            automatic.checked = v[1] === 1; esc.value = v[2]
            second.checked = v[3] === 1; esc2.value = v[4]; channel.value = v[5]
        }
        if (first && !busy) message = "Connected to Express Link."
    }
    Timer { interval: 250; repeat: true; running: true; onTriggered: tick() }
    Connections {
        target: VescIf ? VescIf.commands() : null
        function onLispPrintReceived(str) { root.receive(str) }
    }

    ScrollView {
        anchors.fill: parent
        contentWidth: availableWidth
        ColumnLayout {
            width: parent.width
            spacing: 14
            Label { text: "CU Express Link"; font.pointSize: 20; font.bold: true }
            Label { text: "Package version: {{VERSION}} • Stock Express T 7.00"; opacity: 0.7 }
            Label {
                Layout.fillWidth: true; wrapMode: Text.WordWrap
                text: "Your Express T connects the bike's CAN bus to the CUP-3.5 screen."
            }
            GroupBox {
                title: "Connection"; Layout.fillWidth: true
                ColumnLayout {
                    anchors.fill: parent
                    Label { text: stale ? "Waiting for fresh link status..." :
                                  (link[6] ? "Controller online • CAN " + link[9] : "Waiting for controller telemetry") }
                    Label { text: stale ? "" : link[7] ? "Screen connected" :
                                  link[8] ? "Screen paired • currently offline" : "Waiting for screen pairing" }
                    Label { text: stale ? "" : "Express CAN " + link[11] + " • Active radio channel " + (link[12] || "unknown") }
                    Button {
                        text: "Forget paired screen"; enabled: !stale && !busy && !!link[8] && !link[7]
                        onClicked: queue("(express-forget)", "forget")
                    }
                    Label { Layout.fillWidth: true; wrapMode: Text.WordWrap; opacity: 0.7
                        text: "Turn the paired screen off before clearing its pairing." }
                }
            }
            GroupBox {
                title: "Connection settings"; Layout.fillWidth: true
                ColumnLayout {
                    anchors.fill: parent
                    enabled: !stale && !busy
                    CheckBox { id: automatic; text: "Find controllers automatically"; checked: true
                        onClicked: dirty = true }
                    GridLayout {
                        columns: 2; visible: !automatic.checked; Layout.fillWidth: true
                        Label { text: "Main controller CAN ID" }
                        SpinBox { id: esc; from: 0; to: 253; value: 6; onValueModified: dirty = true }
                        CheckBox { id: second; text: "Second controller"; onClicked: dirty = true }
                        SpinBox { id: esc2; from: 0; to: 253; enabled: second.checked; onValueModified: dirty = true }
                    }
                    RowLayout {
                        Label { text: "Radio channel" }
                        SpinBox { id: channel; from: 1; to: 13; value: 1; onValueModified: dirty = true }
                    }
                    Label { Layout.fillWidth: true; wrapMode: Text.WordWrap; opacity: 0.7
                        text: "Use the same radio channel as your screen. Changes apply after a power cycle." }
                    RowLayout {
                        Button { text: "Save settings"; enabled: dirty; onClicked: save() }
                        Button { text: "Discard edits"; enabled: dirty
                            onClicked: { dirty = false; lastReply = 0; stale = true; message = "Reading saved settings..." } }
                    }
                }
            }
            Label { visible: !stale && link[10] === 1; Layout.fillWidth: true; wrapMode: Text.WordWrap
                text: "Saved connection settings are waiting for a power cycle."; color: "#de9d3c" }
            Label { Layout.fillWidth: true; wrapMode: Text.WordWrap; text: message }
            Label { Layout.fillWidth: true; wrapMode: Text.WordWrap; opacity: 0.7
                text: "Power modes and setup features come from Core or CU Wheelie on the motor controller. " +
                      "This package is installed on the Express T. CAN wiring is required." }
        }
    }
}
