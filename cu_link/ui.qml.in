import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15

Item {
    anchors.fill: parent

    // Commands go out through a queue: the board drops, without a word, a
    // REPL command that arrives within half a second of the one before (the
    // firmware's own guard), so an (ax-apply) right after its (def ...) never
    // ran (2026-10-24). What is sent together goes as one (progn ...), at
    // most every 0.6 s; a newer (def x ...) replaces one still waiting and a
    // waiting refresher with no arguments moves to the back.
    property var sendQ: []
    property double sentAt: 0
    Timer { id: sendTick; interval: 30; repeat: false; onTriggered: flushQ() }
    function send(c) {
        var m = c.match(/^\(def (\S+) /)
        var bare = /^\(\S+\)$/.test(c)
        var q = sendQ.filter(function (p) { return !(bare && p === c) && !(m && p.indexOf("(def " + m[1] + " ") === 0) })
        q.push(c)
        sendQ = q
        if (!sendTick.running) {
            sendTick.interval = Math.max(30, 600 - (Date.now() - sentAt))
            sendTick.start()
        }
    }
    function flushQ() {
        if (sendQ.length === 0) return
        var q = sendQ, batch = [], len = 8
        while (q.length > 0 && (batch.length === 0 || len + q[0].length + 1 < 480)) {
            var c = q.shift(); batch.push(c); len += c.length + 1
        }
        sendQ = q
        try { VescIf.commands().lispSendReplCmd(batch.length === 1 ? batch[0] : "(progn " + batch.join(" ") + ")") }
        catch (e) { status.text = "error: " + e; sendQ = []; return }
        sentAt = Date.now()
        if (sendQ.length > 0) { sendTick.interval = 600; sendTick.start() }
    }
    property bool loading: false
    // Express T has a configurable strip pin; IO-hat plugs stay hidden.
    property bool ioBoard: false
    // the live switch test: what the link last streamed
    property int  swMask: 0
    property bool sLeft: false
    property bool sRight: false
    property bool sHaz: false
    property bool sBeam: false
    property int  sMode: 1
    property bool sDashRuns: false
    property bool sDash: false
    property double swAt: 0
    property bool sDark: false
    property bool sBrake: false
    // the switch actions, in the numbering both packages use; "(display)"
    // ones need a paired display, everything else works on the link alone
    property var swActs: ["Nothing","Mode up","Mode down","Mode cycle","Next page (display)",
        "Previous page (display)","Home page (display)","Mode chip (display)","Left signal",
        "Right signal","Hazards","High beam","Horn","Cruise","Reset trip (display)",
        "Night mode (display)","Reverse","Brighter (display)","Dimmer (display)","Walk assist",
        "Hold reverse","Choose controller (display)","Release (display)","BMS on/off (display)",
        "Mode 1","Mode 2","Mode 3","Neutral","Lights off","Brake light","Logging on/off",
        "CU Wheelie arm"]
    property var swModes: ["Neutral","Mode 1","Mode 2","Mode 3"]
    property bool blinkOn: true



    // The read-back sits in a Loader so a signal this build of VESC Tool does
    // not have takes only the loader with it. At the root, an unknown signal
    // stops the whole page instantiating and the settings never appear.
    Loader {
        id: rb
        active: false
        sourceComponent: Component {
            Item {
            // Ask for the settings once the program has had time to start.
            Timer { interval: 1800; running: true; repeat: false
                    onTriggered: send("(cfg-dump)") }

            // Switch test: ask the link to stream, and keep asking while the
            // page is open. It stops on its own 3 s after the last ask.
            Timer { interval: 1000; running: ioBoard; repeat: true
                    onTriggered: { try { VescIf.commands().sendCustomAppData("SWMON") } catch (e) {} } }
            Connections {
                target: VescIf.commands()
                function onCustomAppDataReceived(data) {
                    var t = data.toString().replace(/\x00+$/g, "")
                    if (t.indexOf("IOSW ") !== 0) return
                    var p = t.split(" ")
                    if (p.length < 9) return
                    swMask = parseInt(p[1])
                    sLeft = p[2] === "1"; sRight = p[3] === "1"
                    sHaz = p[4] === "1";  sBeam = p[5] === "1"
                    sMode = parseInt(p[6])
                    sDashRuns = p[7] === "1"; sDash = p[8] === "1"
                    if (p.length > 10) { sDark = p[9] === "1"; sBrake = p[10] === "1" }
                    swAt = Date.now()
                }
            }

            // Reads the settings back from the board. Without this every control just
            // shows the value it was declared with, which is why the strip tick box
            // could sit unticked while the strip was actually running.
            Connections {
                target: VescIf.commands()
                function onLispPrintReceived(str) {
                    var al = str.indexOf("ANTLIST:")
                    if (al >= 0) {
                        var raw = str.substring(al + 8).trim()
                        var out = []
                        var parts = raw.split(";")
                        for (var k = 0; k < parts.length; k++) {
                            if (parts[k].length < 5) continue
                            var f = parts[k].split(",")
                            var nm = (f[1] && f[1] !== "?") ? f[1] : "unknown"
                            out.push(f[0] + "   " + nm + "   " + f[2] + " dBm")
                        }
                        // a pack usually advertises a name, so float those up
                        out.sort(function(a, b) {
                            var an = a.indexOf("unknown") >= 0 ? 1 : 0
                            var bn = b.indexOf("unknown") >= 0 ? 1 : 0
                            return an - bn
                        })
                        antList.model = out
                        status.text = out.length + " devices"
                        return
                    }
                    var i = str.indexOf("LINK:")
                    if (i < 0) return
                    var v = str.substring(i + 5).trim().split(",")
                    if (v.length < 24) return
                    loading = true
                    var n = function(k) { return parseInt(v[k]) }
                    escId.value    = n(0)
                    esc2En.checked = n(1) === 1
                    esc2Id.value   = n(2)
                    chanBox.value  = n(3)
                    hzBox.value    = n(4)
                    ioId.value     = n(5)
            ioEn.checked   = n(6) === 1
                    chLeft.value   = n(7)
                    chRight.value  = n(8)
                    chBeam.value   = n(9)
                    chHorn.value   = n(10)
                    ltEn.checked   = n(11) === 1
                    ltPin.value    = n(12)
                    ltCount.value  = n(13)
                    if (n(14) >= 0 && n(14) <= 2) ltType.currentIndex = n(14)
                    ltBrake.value  = Math.round(parseFloat(v[15]))
                    ltSweep.checked= n(16) === 1
                    antEn.checked  = n(18) === 1
            socSrc.currentIndex = n(20)
                    walkEn.checked = n(21) === 1
                    walkKph.value  = n(22)
                    walkDuty.value = n(23)
                    // a link from before automatic finding sends one field less
                    if (v.length > 24) escAuto.checked = n(24) === 1
                    // 1023-io and later: the AUX plug and which board this is
                    if (v.length > 28) {
                        axCount.value = n(25)
                        axType.currentIndex = n(26)
                        axRole.currentIndex = n(27)
                        ioBoard = n(28) === 1
                    }
                    if (v.length > 40) {
                        sw1Type.currentIndex = n(29); sw1Pol.currentIndex = n(30)
                        sw1S.currentIndex = n(31);    sw1L.currentIndex = n(32)
                        sw2Type.currentIndex = n(33); sw2Pol.currentIndex = n(34)
                        sw2S.currentIndex = n(35);    sw2L.currentIndex = n(36)
                        swPair.checked = n(37) === 1
                        pm0.currentIndex = n(38); pm1.currentIndex = n(39); pm2.currentIndex = n(40)
                    }

                    loading = false
                    status.text = "read from the link"
                }
            }
            }
        }
    }

    function setv(n, v) { send("(def " + n + " " + v + ")") }
    // floats need a decimal point or LispBM stores an integer
    function setf(n, v) { send("(def " + n + " " + v.toFixed(2) + ")") }

    ScrollView {
        anchors.fill: parent
        contentWidth: availableWidth
        clip: true

    ColumnLayout {
        width: parent.width
        spacing: 8

        Label { text: "CU Express Core"; font.bold: true; font.pointSize: 12 }
        Label { text: "Package version: {{VERSION}}" }

        Label { Layout.fillWidth: true; wrapMode: Text.WordWrap
            text: "Express T links the screen to CAN. Setup features depend on the motor controller package." }

        GroupBox {
            Layout.fillWidth: true
            title: "Controllers"
            ColumnLayout {
                anchors.fill: parent
                CheckBox { id: escAuto; text: "Find controllers automatically"; checked: true
                    onClicked: setv("cfg-esc-auto", checked ? "true" : "false") }
                RowLayout {
                    Layout.fillWidth: true
                    enabled: !escAuto.checked
                    Label { text: "Main ESC id"; Layout.preferredWidth: 90 }
                    SpinBox { id: escId; from: 0; to: 254; value: 0
                        onValueModified: setv("cfg-esc-id", value) }
                }
                RowLayout {
                    Layout.fillWidth: true
                    enabled: !escAuto.checked
                    CheckBox { id: esc2En; text: "Second motor"
                        onClicked: setv("cfg-esc2-en", checked ? "true" : "false") }
                    Label { text: "id" }
                    SpinBox { id: esc2Id; from: 0; to: 254; value: 1
                        onValueModified: setv("cfg-esc2-id", value) }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "With the second motor off the link sends a 32 byte frame. " +
                          "Turning it on extends the frame to 40 bytes carrying the " +
                          "second controller's temps, current and duty."
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            title: "Walk assist"
            ColumnLayout {
                anchors.fill: parent
                CheckBox { id: walkEn; text: "Allow the dash to drive the motor at walking pace"
                    onClicked: setv("cfg-walk-en", checked ? "true" : "false") }
                RowLayout {
                    Layout.fillWidth: true
                    Label { text: "Hold at"; Layout.preferredWidth: 90 }
                    SpinBox { id: walkKph; from: 2; to: 12; value: 6
                        onValueModified: setf("cfg-walk-kph", value) }
                    Label { text: "km/h, up to" }
                    SpinBox { id: walkDuty; from: 4; to: 40; value: 18
                        onValueModified: send("(def cfg-walk-duty " + (value/100).toFixed(2) + ")") }
                    Label { text: "% duty" }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "Assign Walk assist to a button on the dash, then hold it. " +
                          "This is the only thing either package does that drives the " +
                          "motor, so it is off until you turn it on, it only runs while " +
                          "the button is held, and it stops within half a second if the " +
                          "radio drops. Raise the duty if a heavy bike will not move; " +
                          "the speed is held by backing off, so it cannot run away."
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            title: "Lights"
            ColumnLayout {
                anchors.fill: parent
                RowLayout {
                    Layout.fillWidth: true
                    CheckBox { id: ioEn; text: "Use a relay board on CAN"
                        onClicked: setv("cfg-io-en", checked?"true":"false") }
                    Label { text: "Board id"; visible: ioEn.checked }
                    SpinBox { id: ioId; from: 0; to: 254; value: 4
                        visible: ioEn.checked
                        onValueModified: setv("cfg-io-id", value) }
                }
                GridLayout {
                    visible: ioEn.checked
                    Layout.fillWidth: true
                    columns: 4
                    Label { text: "Left" }
                    SpinBox { id: chLeft; from: 0; to: 8; value: 1
                        onValueModified: setv("cfg-ch-left", value) }
                    Label { text: "Right" }
                    SpinBox { id: chRight; from: 0; to: 8; value: 2
                        onValueModified: setv("cfg-ch-right", value) }
                    Label { text: "Beam" }
                    SpinBox { id: chBeam; from: 0; to: 8; value: 3
                        onValueModified: setv("cfg-ch-beam", value) }
                    Label { text: "Horn" }
                    SpinBox { id: chHorn; from: 0; to: 8; value: 4
                        onValueModified: setv("cfg-ch-horn", value) }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "Outputs are driven with CAN_PACKET_IO_BOARD_SET_OUTPUT_DIGITAL, " +
                          "so any VESC IO board works. Set a channel to 0 to disable it."
                }
            }
        }

        
        GroupBox {
            Layout.fillWidth: true
            title: "ANT BMS over Bluetooth"
            ColumnLayout {
                anchors.fill: parent
                RowLayout {
                    Layout.fillWidth: true
                    CheckBox { id: antEn; text: "Read a BLE BMS from this board"
                        onClicked: setv("cfg-ant-en", checked?"true":"false") }
                    Button { text: "Start"; onClicked: send("(ant-start)") }
                    Button { text: "Status"; onClicked: send("(ant-info)") }
                }                    RowLayout {
                        visible: antEn.checked
                        Button { text: "Scan"; Layout.preferredHeight: 40
                            onClicked: { status.text = "scanning..."
                                         send("(ant-list)") } }
                        ComboBox { id: antList
                            Layout.fillWidth: true; Layout.preferredHeight: 40
                            model: [] }
                        Button { text: "Use"; Layout.preferredHeight: 40
                            enabled: antList.count > 0
                            onClicked: {
                                var m = antList.currentText.split(" ")[0]
                                status.text = "connecting to " + m
                                send("(ant-use \"" + m + "\")")
                            } }
                    }
                    RowLayout {
                        Layout.fillWidth: true
                        visible: antEn.checked
                        Label { text: "Charge % from" }
                        ComboBox { id: socSrc
                            Layout.fillWidth: true
                            model: ["Controller", "BMS"]
                            onActivated: setv("cfg-soc-src", currentIndex) }
                    }
                    Label {
                        visible: antEn.checked
                        Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                        text: "Needs the VESC Express build with the BLE central patch. " +
                              "Cells are published as a normal VESC BMS, so they reach " +
                              "VESC Tool, the controller over CAN and the dash without " +
                              "further setup. The controller works charge out from its " +
                              "configured cell count; a BMS measures the pack directly. " +
                              "Whichever is chosen, the other is used if it goes quiet."
                    }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            title: "LED strip"
            ColumnLayout {
                anchors.fill: parent
                RowLayout {
                    Layout.fillWidth: true
                    CheckBox { id: ltEn; text: "Drive a strip from this board"
                        onClicked: { setv("cfg-lt-en", checked?"true":"false")
                                     send("(lights-apply)") } }
                    Button { text: "Test"; visible: ltEn.checked
                        onClicked: send("(lights-test)") }
                }
                GridLayout {
                    visible: ltEn.checked
                    Layout.fillWidth: true
                    columns: 4
                    Label { text: ioBoard ? "Plug" : "Pin" }
                    SpinBox { id: ltPin; from: 0; to: 21; value: 20; visible: !ioBoard
                        onValueModified: setv("cfg-lt-pin", value) }
                    Label { text: "TAIL"; visible: ioBoard }
                    Label { text: "LEDs" }
                    SpinBox { id: ltCount; from: 2; to: 120; value: 15
                        onValueModified: setv("cfg-lt-count", value) }
                    Label { text: "Type" }
                    ComboBox { id: ltType; Layout.fillWidth: true
                        model: ["GRB WS2812","RGB","GRBW SK6812"]
                        currentIndex: 2
                        onActivated: setv("cfg-lt-type", currentIndex) }
                    Label { text: "Brake A" }
                    SpinBox { id: ltBrake; from: 0; to: 60; value: 3
                        onValueModified: send("(def cfg-brake-a " + value + ".0)") }
                }
                CheckBox { id: ltSweep; text: "Sweeping indicators"; checked: true
                    visible: ltEn.checked
                    onClicked: setv("cfg-lt-sweep", checked?"true":"false") }
                Label {
                    visible: ltEn.checked
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "Running light always on, brake overrides it from regen " +
                          "current, indicators sweep outward from the centre. Set " +
                          "Brake A to 0 to disable the automatic brake light."
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            visible: ioBoard
            title: "AUX plug"
            ColumnLayout {
                anchors.fill: parent
                GridLayout {
                    Layout.fillWidth: true
                    columns: 4
                    Label { text: "LEDs" }
                    SpinBox { id: axCount; from: 0; to: 120; value: 0
                        onValueModified: { setv("cfg-ax-count", value); send("(ax-apply)") } }
                    Label { text: "Type" }
                    ComboBox { id: axType; Layout.fillWidth: true
                        model: ["GRB WS2812","RGB","GRBW SK6812"]
                        currentIndex: 2
                        onActivated: { setv("cfg-ax-type", currentIndex); send("(ax-apply)") } }
                    Label { text: "Use" }
                    ComboBox { id: axRole; Layout.fillWidth: true; Layout.columnSpan: 3
                        model: ["Copy of the tail strip","Headlight","Left signal","Right signal"]
                        onActivated: setv("cfg-ax-role", currentIndex) }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "0 LEDs turns the plug off. The headlight is white, full " +
                          "brightness on high beam, with the turning side amber."
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            visible: ioBoard
            title: "Switch test (live)"
            ColumnLayout {
                anchors.fill: parent
                spacing: 10
                // blinks the signal lamps the way the lights do
                Timer { interval: 400; running: ioBoard; repeat: true
                        onTriggered: blinkOn = !blinkOn }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10
                    Repeater {
                        model: ["SW1", "SW2"]
                        Rectangle {
                            Layout.fillWidth: true
                            Layout.preferredHeight: 64
                            radius: 10
                            property bool on: (swMask & (1 << index)) !== 0
                            color: on ? "#22c55e" : "#2a2f36"
                            border.color: on ? "#86efac" : "#444b55"
                            border.width: 2
                            Behavior on color { ColorAnimation { duration: 60 } }
                            Label {
                                anchors.centerIn: parent
                                text: modelData + (parent.on ? "  PRESSED" : "")
                                color: parent.on ? "#04210f" : "#c9d1d9"
                                font.bold: true; font.pointSize: 13
                            }
                        }
                    }
                }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8
                    Rectangle {
                        Layout.preferredWidth: 70; Layout.preferredHeight: 44; radius: 8
                        property bool lit: (sLeft || sHaz) && blinkOn
                        color: lit ? "#f59e0b" : "#2a2f36"
                        Label { anchors.centerIn: parent; text: "\u25C0 L"; font.bold: true
                                color: parent.lit ? "#1f1300" : "#8b949e" }
                    }
                    Rectangle {
                        Layout.fillWidth: true; Layout.preferredHeight: 44; radius: 8
                        color: sHaz ? "#7c2d12" : "#2a2f36"
                        Label { anchors.centerIn: parent; font.bold: true
                                text: sHaz ? "HAZARDS" : ((sBeam ? "HIGH BEAM  " : "") +
                                      (sBrake ? "BRAKE  " : "") + (sDark ? "LIGHTS OFF" : "") ||
                                      "lights normal")
                                color: sHaz ? "#fed7aa" : (sBrake ? "#fca5a5" : (sBeam ? "#93c5fd" : "#8b949e")) }
                    }
                    Rectangle {
                        Layout.preferredWidth: 70; Layout.preferredHeight: 44; radius: 8
                        property bool lit: (sRight || sHaz) && blinkOn
                        color: lit ? "#f59e0b" : "#2a2f36"
                        Label { anchors.centerIn: parent; text: "R \u25B6"; font.bold: true
                                color: parent.lit ? "#1f1300" : "#8b949e" }
                    }
                    Rectangle {
                        Layout.preferredWidth: 70; Layout.preferredHeight: 44; radius: 8
                        color: "#ff8000"
                        Label { anchors.centerIn: parent; font.bold: true; font.pointSize: 14
                                color: "#000000"
                                text: sMode === -1 ? "R" : (sMode === 0 ? "N" : "" + sMode) }
                    }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    // re-read with the blink so it goes red when the stream stops
                    color: (blinkOn || !blinkOn) && (Date.now() - swAt) < 1500 ? "#6c6" : "#e66"
                    text: swAt === 0 ? "waiting for the link..." :
                          (sDashRuns ? "The display is running the switches - set them on its " +
                                       "page under Buttons. Lamps show what it did." :
                           (sDash ? "A display is connected but too old to run the switches: " +
                                    "the link does left / right / hazards itself." :
                                    "No display: the link does SW1 left, SW2 right, both hazards."))
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            visible: ioBoard
            title: "Switches"
            ColumnLayout {
                anchors.fill: parent
                CheckBox { id: swPair; text: "SW1 + SW2 are one 3-position speed switch"
                    onClicked: setv("cfg-sw-pair", checked ? 1 : 0) }
                GridLayout {
                    visible: swPair.checked
                    Layout.fillWidth: true
                    columns: 2
                    Label { text: "Neither" }
                    ComboBox { id: pm0; Layout.fillWidth: true; model: swModes; currentIndex: 1
                        onActivated: setv("cfg-sw-pm0", currentIndex) }
                    Label { text: "SW1" }
                    ComboBox { id: pm1; Layout.fillWidth: true; model: swModes; currentIndex: 2
                        onActivated: setv("cfg-sw-pm1", currentIndex) }
                    Label { text: "SW2" }
                    ComboBox { id: pm2; Layout.fillWidth: true; model: swModes; currentIndex: 3
                        onActivated: setv("cfg-sw-pm2", currentIndex) }
                }
                GridLayout {
                    visible: !swPair.checked
                    Layout.fillWidth: true
                    columns: 3
                    Label { text: "" }
                    Label { text: "SW1"; font.bold: true }
                    Label { text: "SW2"; font.bold: true }
                    Label { text: "Switch" }
                    ComboBox { id: sw1Type; Layout.fillWidth: true
                        model: ["Button (momentary)","On/off switch"]
                        onActivated: setv("cfg-sw1-type", currentIndex) }
                    ComboBox { id: sw2Type; Layout.fillWidth: true
                        model: ["Button (momentary)","On/off switch"]
                        onActivated: setv("cfg-sw2-type", currentIndex) }
                    Label { text: "Active when" }
                    ComboBox { id: sw1Pol; Layout.fillWidth: true
                        model: ["Closed to GND","Open"]
                        onActivated: setv("cfg-sw1-pol", currentIndex) }
                    ComboBox { id: sw2Pol; Layout.fillWidth: true
                        model: ["Closed to GND","Open"]
                        onActivated: setv("cfg-sw2-pol", currentIndex) }
                    Label { text: "Press / on" }
                    ComboBox { id: sw1S; Layout.fillWidth: true; model: swActs; currentIndex: 8
                        onActivated: setv("cfg-sw1-s", currentIndex) }
                    ComboBox { id: sw2S; Layout.fillWidth: true; model: swActs; currentIndex: 9
                        onActivated: setv("cfg-sw2-s", currentIndex) }
                    Label { text: "Long press" }
                    ComboBox { id: sw1L; Layout.fillWidth: true; model: swActs; currentIndex: 0
                        enabled: sw1Type.currentIndex === 0
                        onActivated: setv("cfg-sw1-l", currentIndex) }
                    ComboBox { id: sw2L; Layout.fillWidth: true; model: swActs; currentIndex: 0
                        enabled: sw2Type.currentIndex === 0
                        onActivated: setv("cfg-sw2-l", currentIndex) }
                }
                Label {
                    Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
                    text: "A button does its press action at once, or - with a long " +
                          "press set - on release, and the long one after 0.7 s. Horn, " +
                          "walk assist, hold reverse and brake light act while held. An " +
                          "on/off switch holds signals, beam, lights off, brake, horn, " +
                          "walk, reverse, neutral and mode 1-3 while it is on (and goes " +
                          "back when it is off); anything else happens as it switches " +
                          "on. Two buttons on left and right signal: both together are " +
                          "hazards. Everything works with no display; '(display)' ones " +
                          "need one paired. Modes need Dash ESC on the controller, or a " +
                          "display paired once so the link has learned its limits. " +
                          "Press SAVE to keep changes."
                }
            }
        }

        GroupBox {
            Layout.fillWidth: true
            title: "Radio"
            RowLayout {
                anchors.fill: parent
                Label { text: "Channel" }
                SpinBox { id: chanBox; from: 1; to: 13; value: 1
                    onValueModified: setv("cfg-chan", value) }
                Label { text: "Rate Hz" }
                SpinBox { id: hzBox; from: 1; to: 30; value: 15
                    onValueModified: send("(def cfg-hz " + value + ".0)") }
            }
        }

        RowLayout {
            Layout.fillWidth: true
            Button { text: "Read"; Layout.fillWidth: true
                onClicked: send("(cfg-dump)") }
            Button { text: "SAVE"; Layout.fillWidth: true
                Layout.preferredHeight: 44
                onClicked: { send("(cfg-save)"); status.text = "saved" } }
        }

        Label { id: status; text: ""; color: "#6c6"; font.pointSize: 9 }
        Label {
            Layout.fillWidth: true; wrapMode: Text.WordWrap; font.pointSize: 9
            text: "The channel must match the display. Enable CAN status messages " +
                  "1 to 5 on each controller."
        }
        Item { Layout.preferredHeight: 24 }
    }
    }




    Component.onCompleted: rb.active = true

}
