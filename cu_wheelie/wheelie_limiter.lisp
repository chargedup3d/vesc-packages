(def br-hold     0)
(defun brake-update ()
(let ((dt (clamp (secs-since br-t-last) 0.01 0.2)) (sp (abs (get-speed))))
(progn
(setvar 'br-t-last (systime))
(var a (/ dt (+ 0.15 dt)))
(setvar 'br-decel (+ br-decel (* a (- (/ (- br-v-last sp) dt) br-decel))))
(setvar 'br-v-last sp)
(if (> whl-rider 0.02) (setvar 'br-thr-t (systime)))
(if (or (>= br-decel brk-decel)
(and (> brk-off-s 0.0) (>= (secs-since br-thr-t) brk-off-s)
(> sp 1.34) (> br-decel 0.2))
(and (> brk-regen-a 0.0) (< (get-current) (- brk-regen-a)))
(< whl-out -0.1))
(setvar 'br-hold (systime)))
(setvar 'whl-brake (if (< (secs-since br-hold) 0.4) 1 0)))))
