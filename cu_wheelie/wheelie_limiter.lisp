(defun whl-input-config () {
(var app (conf-get 'app-to-use))
(var mode (conf-get 'adc-ctrl-type))
(var hyst (conf-get 'adc-thr-hyst))
(var ramp (conf-get 'adc-ramp-time-neg))
(setvar 'whl-adc-mode mode)
(if (and (number? hyst) (>= hyst 0.0) (< hyst 0.95)
(number? ramp) (>= ramp 0.0) (<= ramp 10.0)) {
(setvar 'thr-db (if (< hyst 0.01) 0.01 hyst))
(setvar 'whl-brake-ramp ramp)
(and (or (= app 2) (= app 5)) (or (= mode 1) (= mode 8)))
} nil)
})
(defun whl-brake-input ()
(if (= whl-adc-mode 8) (clamp (get-adc-decoded 1) 0.0 1.0) 0.0))
(defun whl-brake-guard (raw dt) {
(var brake (whl-brake-input))
(setvar 'whl-brake-demand (if (> brake thr-db) (/ (- brake thr-db) (- 1.0 thr-db)) 0.0))
(if (and (> whl-brake-demand 0.0)
(or (= whl-armed 1) (= whl-crash 1) (= whl-ctrl 1) whl-brake-hold))
(setvar 'whl-brake-hold t))
(if whl-brake-hold {
(app-disable-output 100)
(setvar 'whl-ctrl 1)
(setvar 'whl-rider 0.0)
(setvar 'lost-out0 0.0)
(if (> whl-brake-demand 0.0) {
(setvar 'whl-brake-release (systime))
(setvar 'whl-regen (if (> whl-brake-ramp 0.0)
(clamp (+ whl-regen (/ dt whl-brake-ramp)) 0.0 whl-brake-demand) whl-brake-demand))
(setvar 'whl-out (- whl-regen))
(set-brake-rel whl-regen)
} {
(setvar 'whl-regen 0.0)
(setvar 'whl-out 0.0)
(set-current 0.0)
(if (>= raw thr-db) (setvar 'whl-brake-release (systime))
(if (>= (secs-since whl-brake-release) 0.3) (setvar 'whl-brake-hold nil)))
})
t
} { (setvar 'whl-regen 0.0) nil })
})
