(defun apply-set (data)
(progn
(whl-set-reg 0 (bufget-f32 data 1))
(whl-set-reg 1 (bufget-f32 data 5))
(whl-set-reg 2 (bufget-f32 data 9))
(whl-set-reg 3 (bufget-f32 data 13))
(whl-set-reg 4 (bufget-f32 data 17))
(whl-set-reg 5 (bufget-f32 data 21))
(if (>= (buflen data) 31)
(progn
(setvar 'imu-src   (clamp (bufget-u8 data 25) 0 2))
(setvar 'ex-offset (clamp (bufget-u8 data 26) 0 15))
(setvar 'stale-ms  (clamp (bufget-f32 data 27) 20.0 500.0))))
(if (>= (buflen data) 44)
(progn
(setvar 'crash-pitch (clamp (bufget-f32 data 31) 30.0 90.0))
(setvar 'crash-roll  (clamp (bufget-f32 data 35) 20.0 90.0))
(setvar 'crash-ms    (clamp (bufget-f32 data 39) 50.0 2000.0))
(setvar 'crash-mode  (if (= (bufget-u8 data 43) 0) 0 1))))
(if (>= (buflen data) 48)
(setvar 'letdown-s (clamp (bufget-f32 data 44) 0.2 5.0)))
(if (>= (buflen data) 54)
(progn
(setvar 'log-en (if (= (bufget-u8 data 48) 0) 0 1))
(setvar 'log-id (if (= (bufget-u8 data 49) 255) -1 (bufget-u8 data 49)))
(setvar 'log-hz (clamp (bufget-f32 data 50) 1.0 100.0))))
(if (>= (buflen data) 66)
(progn
(setvar 'brk-decel   (clamp (bufget-f32 data 54) 0.3 6.0))
(setvar 'brk-off-s   (clamp (bufget-f32 data 58) 0.0 10.0))
(setvar 'brk-regen-a (clamp (bufget-f32 data 62) 0.0 50.0))))
(whl-save)
(send-conf)))
(def rt-want-t 0)
(defun rt-wanted () (and (> rt-want-t 0) (< (secs-since rt-want-t) 3.0) (not (ms-ble-active))))
(defun handle-rx (data)
(progn
(setvar 'rt-want-t (systime))
(if (and (not (ms-ble-rx data)) (>= (buflen data) 1))
(let ((cmd (bufget-u8 data 0)))
(cond
((= cmd 1) (send-conf))
((and (= cmd 2) (>= (buflen data) 25)) (apply-set data))
((= cmd 3) (whl-can-arm 2))
(t nil))))))
(defun event-loop ()
(loopwhile t
(recv
((event-data-rx . (? data)) (handle-rx data))
((event-can-sid . ((? id) . (? data)))
(if (= id (+ 0x5A0 ex-offset))
(progn
(ex-handle data)
(if ctrl-pid (send ctrl-pid 'frame)))
(progn (im-rx id data) (whl-can-handle id data))))
(_ nil))))
(def slow-t 0)
(defun telem-loop ()
(loopwhile t
(progn
(if (rt-wanted) (send-data (str-merge "rt "
(str-from-n whl-pitch "%.2f ")
(str-from-n prate-f   "%.1f ")
(str-from-n whl-armed "%d ")
(str-from-n whl-out   "%.3f ")
(str-from-n whl-rider "%.3f ")
(str-from-n act-src   "%d ")
(str-from-n (if (= ex-seen 1) (ex-age-ms) -1.0) "%.0f ")
(str-from-n ex-drops-ps "%d ")
(str-from-n whl-fault "%d ")
(str-from-n whl-roll  "%.2f ")
(str-from-n whl-crash "%d ")
(str-from-n lost-phase "%d ")
(str-from-n log-on "%d ")
(str-from-n ex-pitch "%.2f ")
(str-from-n ex-roll  "%.2f ")
(str-from-n ex-flags "%d ")
(str-from-n whl-brake "%d ")
(str-from-n br-decel "%.2f"))))
(brake-update)
(if (> whl-can-telem-rate 0)
(progn
(setvar 'whl-can-telem-cnt (+ whl-can-telem-cnt 1))
(if (>= whl-can-telem-cnt whl-can-telem-rate)
(progn (setvar 'whl-can-telem-cnt 0) (whl-can-send-telem) (whl-can-send-attitude)))))
(if (>= (secs-since slow-t) 0.1)
(progn
(setvar 'slow-t (systime))
(setvar 'drops-tick (+ drops-tick 1))
(if (>= drops-tick 10)
(progn
(setvar 'drops-tick 0)
(setvar 'ex-drops-ps (- ex-drops ex-drops-last))
(setvar 'ex-drops-last ex-drops)))
nil))
(sleep 0.04))))
(def last-step-t 0)
(def ua-sum 0.0)
(def ua-n 0)
(def ua-max 0.0)
(defun lpf-alpha (a steps)
(if (>= a 0.999) 1.0
(- 1.0 (exp (* steps (log (- 1.0 a)))))))
(defun wheelie-step ()
(progn
(if (and (not (whl-input-config)) (= whl-armed 1)) {
(setvar 'whl-armed 0)
(setvar 'whl-brake-hold t)
(setvar 'whl-brake-release (systime))
})
(var inputs (atomic {
(var pair (list (ex-copy) ex-pending-gap))
(setvar 'ex-pending-gap nil)
pair
}))
(var sample (ix inputs 0))
(var src (pick-src-sample sample))
(if (and (= whl-armed 1) (ix inputs 1))
(raise-imu-fault (ix inputs 1) src))
(if (not (= src act-src))
(progn
(setvar 'ok-since (systime))
(if (= whl-armed 1) (raise-imu-fault sample src))))
(if (and (= src 0) (= whl-armed 1)) (raise-imu-fault sample src))
(var pitch (cond ((= src 2) (ix sample 0))
((= src 1) (* pitch-sign (rad2deg (ix (get-imu-rpy) 1))))
(t whl-pitch)))
(var rate (cond ((= src 2) (ix sample 2))
((= src 1) (* pitch-sign (ix (get-imu-gyro) 1)))
(t 0.0)))
(if (not (= src act-src)) (setvar 'prate-f rate))
(setvar 'act-src src)
(setvar 'whl-pitch pitch)
(var dt (clamp (secs-since last-step-t) 0.0005 0.05))
(setvar 'last-step-t (systime))
(var steps (/ dt 0.01))
(var a-rate (lpf-alpha rate-lpf steps))
(setvar 'prate-f (+ (* prate-f (- 1.0 a-rate)) (* rate a-rate)))
(if (= src 2)
(let ((ag (ix sample 4)))
(progn
(setvar 'ua-sum (+ ua-sum ag))
(setvar 'ua-n (+ ua-n 1))
(if (> ag ua-max) (setvar 'ua-max ag)))))
(if (= whl-armed 0) (progn (setvar 'whl-fault 0) (setvar 'lost-phase 0)))
(if (and (= whl-fault 1) (= lost-phase 3) (> src 0)
(>= (secs-since ok-since) 0.2) (< pitch whl-start)
(< (clamp (get-adc-decoded 0) 0.0 1.0) thr-db))
(progn (setvar 'whl-fault 0) (setvar 'lost-phase 0)))
(var raw (clamp (get-adc-decoded 0) 0.0 1.0))
(var db (if (< raw thr-db) 0.0 (/ (- raw thr-db) (- 1.0 thr-db))))
(var a-thr (lpf-alpha thr-lpf steps))
(setvar 'whl-rider (+ (* whl-rider (- 1.0 a-thr)) (* db a-thr)))
(var roll (cond ((= src 2) (ix sample 1))
((= src 1) (rad2deg (ix (get-imu-rpy) 0)))
(t whl-roll)))
(setvar 'whl-roll roll)
(var over (and (> src 0)
(or (>= pitch crash-pitch) (>= (abs roll) crash-roll))))
(if over
(if (and (= whl-crash 0)
(or (= crash-mode 1) (= whl-armed 1))
(>= (secs-since over-since) (/ crash-ms 1000.0)))
(setvar 'whl-crash 1))
(setvar 'over-since (systime)))
(if (= whl-crash 1)
(if (> src 0)
(if (and (< raw thr-db) (< pitch whl-start)
(< (abs roll) (- crash-roll 10.0)))
(if (>= (secs-since clear-since) 0.5) (setvar 'whl-crash 0))
(setvar 'clear-since (systime)))
(if (< raw thr-db)
(if (>= (secs-since clear-since) 0.3)
(progn
(setvar 'whl-crash 0)
(setvar 'whl-fault 1)
(setvar 'lost-phase 3)
(setvar 'whl-rider 0.0)))
(setvar 'clear-since (systime)))))
(if (not (whl-brake-guard raw dt))
(if (= whl-crash 1)
(progn
(app-disable-output 100)
(setvar 'whl-ctrl 1)
(setvar 'whl-out 0.0)
(set-current 0.0))
(if (and (= whl-armed 1) (= whl-fault 0))
(progn
(app-disable-output 100)
(setvar 'whl-ctrl 1)
(var span (- whl-end whl-start))
(if (< span 1.0) (setq span 1.0))
(var ctrl (- (/ (- (+ whl-start span) pitch) span)
(* whl-damp prate-f)))
(if (>= ctrl 0.0)
(progn
(setvar 'whl-out (clamp (* whl-rider ctrl) 0.0 whl-rider))
(set-current-rel whl-out))
(progn
(setvar 'whl-out (clamp ctrl (- pull-max) 0.0))
(set-current-rel whl-out))))
(if (and (= whl-armed 1) (< lost-phase 3))
(progn
(app-disable-output 100)
(setvar 'whl-ctrl 1)
(if (= lost-phase 1)
(let ((k (- 1.0 (/ (secs-since lost-t) letdown-s))))
(if (<= k 0.0)
(progn (setvar 'lost-phase 2) (setvar 'rel-since (systime)))
(progn
(setvar 'whl-out (* lost-out0 k))
(if (> whl-out whl-rider) (setvar 'whl-out whl-rider))
(set-current-rel whl-out)))))
(if (= lost-phase 2)
(progn
(setvar 'whl-out 0.0)
(set-current 0.0)
(if (< raw thr-db)
(if (>= (secs-since rel-since) 0.3) (setvar 'lost-phase 3))
(setvar 'rel-since (systime))))))
(progn
(setvar 'whl-out 0.0)
(if (= whl-ctrl 1)
(progn (app-disable-output 0) (setvar 'whl-ctrl 0))))))))))
(defun control-step () { (hd-guard) (ms-guard) (if ms-lock (ms-hold) (if hc-lock (hc-hold) (wheelie-step))) })
(def ctrl-pid nil)
(defun control-loop ()
(loopwhile t
(progn
(recv-to 0.01
(frame nil)
(timeout nil)
(_ nil))
(control-step))))
(def log-on 0)
(def log-cur-id -1)
(def log-cur-hz 0.0)
(def log-ex-gap 0)
(def log-fields (list
(list "pitch"    "Pitch"            "deg"   2)
(list "roll"     "Roll"             "deg"   2)
(list "prate"    "Pitch rate"       "deg/s" 1)
(list "src"      "IMU source"       ""      0)
(list "ex_age"   "Express age"      "ms"    0)
(list "ex_drops" "Express drops"    "/s"    0)
(list "armed"    "Armed"            ""      0)
(list "fault"    "IMU fault"        ""      0)
(list "lost"     "Let-down phase"   ""      0)
(list "crash"    "Crash cutoff"     ""      0)
(list "thr"      "Throttle"         "%"     1)
(list "out"      "Output"           "%"     1)
(list "current"  "Motor current"    "A"     1)
(list "erpm"     "ERPM"             ""      0)
(list "duty"     "Duty"             "%"     1)
(list "vin"      "Battery"          "V"     2)
(list "temp_fet" "FET temp"         "degC"  1)
(list "ex_flags" "Express flags"    ""      0)
(list "brake"    "Brake light"      ""      0)
(list "decel"    "Deceleration"     "m/s2"  2)))
(defun log-begin ()
(progn
(var i 0)
(loopforeach f log-fields
(progn
(log-config-field log-id i (ix f 0) (ix f 1) (ix f 2) (ix f 3) nil nil)
(setq i (+ i 1))))
(log-start log-id (length log-fields) log-hz t nil)
(setvar 'log-cur-id log-id)
(setvar 'log-cur-hz log-hz)
(setvar 'log-on 1)))
(defun log-end ()
(progn
(if (>= log-cur-id 0) (log-stop log-cur-id))
(setvar 'log-on 0)))
(defun log-sample ()
(log-send-f32 log-id 0
whl-pitch whl-roll prate-f act-src
(if (= ex-seen 1) (ex-age-ms) -1.0) ex-drops-ps
whl-armed whl-fault lost-phase whl-crash
(* whl-rider 100.0) (* whl-out 100.0)
(get-current) (get-rpm) (* (get-duty) 100.0) (get-vin) (get-temp-fet)
ex-flags whl-brake br-decel))
(defun log-loop ()
(loopwhile t
(progn
(var want (and (= log-en 1) (>= log-id 0) (= (bitwise-and ex-flags 8) 8)))
(if (and (= ex-seen 1) (> (ex-age-ms) 1000.0)) (setvar 'log-ex-gap 1))
(if (and (= log-on 1)
(or (not want) (not (= log-id log-cur-id)) (not (= log-hz log-cur-hz))
(and (= log-ex-gap 1) (< (ex-age-ms) 100.0))))
(progn (log-end) (setvar 'log-ex-gap 0)))
(if (and want (= log-on 0) (= ex-seen 1) (< (ex-age-ms) 100.0))
(progn (setvar 'log-ex-gap 0) (log-begin)))
(if (= log-on 1) (log-sample))
(sleep (/ 1.0 log-hz)))))
(defun main () {
(ms-init) (im-init) (hc-init)
(if (let ((m (eeprom-read-i 0))) (and m (= m whl-magic)))
(whl-load)
(whl-save))
(setvar 'whl-canid (can-local-id))
(setvar 'over-since (systime))
(setvar 'clear-since (systime))
(setvar 'br-t-last (systime))
(setvar 'br-thr-t (systime))
(setvar 'br-hold (systime))
(setvar 'lost-t (systime))
(setvar 'rel-since (systime))
(setvar 'ex-time (systime))
(setvar 'ok-since (systime))
(setvar 'slow-t (systime))
(setvar 'last-step-t (systime))
(setvar 'whl-can-tx-t (bufcreate 8))
(setvar 'whl-can-tx-r (bufcreate 8))
(setvar 'whl-armed 0)
(def ms-probe-result nil)
(def ms-load-result (trap (load-native-lib ms-adc-native)))
(if (and (eq (car ms-load-result) 'exit-ok) (ix ms-load-result 1)) {
(def ms-probe-result (trap (ext-ms-adc-save 0 0.0 0.0)))
(setvar 'ms-save-native-ok (and (eq (car ms-probe-result) 'exit-ok) (= (ix ms-probe-result 1) 1)))
})
(trap (bs-load))
(event-register-handler (spawn event-loop))
(event-enable 'event-data-rx)
(event-enable 'event-can-sid)
(spawn telem-loop)
(setvar 'ctrl-pid (spawn control-loop))
(spawn log-loop)
(spawn hc-loop)
(spawn ms-loop)
(print (str-merge "CU Wheelie v" whl-version " started"))
})
@const-end
