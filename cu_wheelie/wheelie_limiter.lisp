(setvar 'lost-out0 whl-out))))
(def ex-pitch 0.0)
(def ex-roll  0.0)
(def ex-prate 0.0)
(def ex-flags 0)
(def ex-time  0)
(def ex-seen  0)
(def ex-seq   -1)
(def ex-drops 0)
(def ex-drops-ps 0)
(def ex-drops-last 0)
(def drops-tick 0)
(def act-src 0)
(def whl-fault 0)
(def ok-since 0)
(def ok-run 0)
(def ex-duplicates 0)
(def ex-max-gap-ms 0.0)
(def ex-pending-gap nil)
(def imu-fault-count 0)
(def imu-last-fault nil)
(defun ex-copy ()
(list ex-pitch ex-roll ex-prate ex-flags (ex-age-ms) ex-seen ex-seq))
(defun ex-snapshot () (atomic (ex-copy)))
(defun ex-sample-valid (sample)
(and (= (ix sample 5) 1) (< (ix sample 4) stale-ms)
(= (bitwise-and (ix sample 3) 3) 3)))
(defun raise-imu-fault (sample src)
(if (= whl-fault 0) {
(setvar 'imu-fault-count (+ imu-fault-count 1))
(setvar 'imu-last-fault (list
(cond ((= (ix sample 5) 0) 3) ((>= (ix sample 4) stale-ms) 1)
((!= (bitwise-and (ix sample 3) 3) 3) 2) (t 4))
(ix sample 4) (ix sample 3) (ix sample 6) act-src src))
(raise-fault)
}))
(defun imu-diagnostics ()
(list imu-fault-count imu-last-fault ex-max-gap-ms ex-duplicates ex-drops))
(defun pick-src-sample (sample)
(cond
((= imu-src 0) 1)
((= imu-src 1) (if (ex-sample-valid sample) 2 0))
(t (if (ex-sample-valid sample) 2 (if (int-valid) 1 0)))))
(defun ex-handle (data)
(if (and (>= (buflen data) 8)
(= (shr (bitwise-and (bufget-u8 data 7) 0xE0) 5) 1))
(let ((p (/ (bufget-i16 data 0 'little-endian) 100.0))
(r (/ (bufget-i16 data 2 'little-endian) 100.0))
(v (/ (bufget-i16 data 4 'little-endian) 10.0))
(flags (bufget-u8 data 7)) (sq (bufget-u8 data 6)))
(atomic {
(var age (ex-age-ms))
(if (and (= ex-seen 1) (> age ex-max-gap-ms)) (setvar 'ex-max-gap-ms age))
(if (and (= ex-seen 1) (>= age stale-ms) (= whl-armed 1)
(= act-src 2) (not ex-pending-gap))
(setvar 'ex-pending-gap (ex-copy)))
(if (and (= ex-seen 1) (= sq ex-seq))
{ (setvar 'ex-duplicates (+ ex-duplicates 1)) nil }
{
(setvar 'ex-pitch p) (setvar 'ex-roll r)
(setvar 'ex-prate v) (setvar 'ex-flags flags)
(if (>= ex-seq 0)
(setvar 'ex-drops (+ ex-drops (bitwise-and (- sq (+ ex-seq 1)) 0xFF))))
(setvar 'ex-seq sq) (setvar 'ex-seen 1)
(setvar 'ex-time (systime))
t
})
}))))
(defun ex-age-ms () (* (secs-since ex-time) 1000.0))
(defun ex-valid () (ex-sample-valid (ex-snapshot)))
(defun int-valid ()
(let ((a (get-imu-acc)))
(let ((m (sqrt (+ (* (ix a 0) (ix a 0)) (* (ix a 1) (ix a 1)) (* (ix a 2) (ix a 2))))))
(and (> m 0.5) (< m 1.5)))))
(defun pick-src () (pick-src-sample (ex-snapshot)))
(def whl-mark    0x57)
(def whl-sid-cmd 0x500)
(def whl-sid-rsp 0x540)
(def whl-canid   0)
(def whl-cmd-read-all  0x01)
(def whl-cmd-read-reg  0x02)
(def whl-cmd-write-reg 0x03)
(def whl-cmd-save      0x04)
(def whl-cmd-arm       0x05)
(def whl-cmd-sub       0x06)
(def whl-rsp-telem     0x81)
(def whl-rsp-config    0x82)
(def whl-rsp-ack       0x83)
(def whl-rsp-attitude  0x84)
(def whl-can-tx-t nil)
(def whl-can-tx-r nil)
(def whl-can-telem-rate 1)
(def whl-can-telem-cnt  0)
(defun whl-get-reg (reg)
(cond
((= reg 0) whl-start)
((= reg 1) whl-end)
((= reg 2) whl-damp)
((= reg 3) pull-max)
((= reg 4) rate-lpf)
((= reg 5) pitch-sign)
(t 0.0)))
(defun whl-set-reg (reg val)
(cond
((= reg 0) (setvar 'whl-start (clamp val 0.0 60.0)))
((= reg 1) (setvar 'whl-end (clamp val 10.0 75.0)))
((= reg 2) (setvar 'whl-damp (clamp val 0.0 1.0)))
((= reg 3) (setvar 'pull-max (clamp val 0.0 1.0)))
((= reg 4) (setvar 'rate-lpf (clamp val 0.01 1.0)))
((= reg 5) (setvar 'pitch-sign (if (< val 0.0) -1.0 1.0)))
(t nil)))
(defun whl-can-send-config (reg)
(let ((tx whl-can-tx-r))
(progn
(bufset-u8  tx 0 whl-mark)
(bufset-u8  tx 1 whl-rsp-config)
(bufset-u8  tx 2 reg)
(bufset-u8  tx 3 0)
(bufset-f32 tx 4 (to-float (whl-get-reg reg)))
(can-send-sid (+ whl-sid-rsp whl-canid) tx))))
(defun whl-can-send-all ()
(progn
(whl-can-send-config 0) (whl-can-send-config 1)
(whl-can-send-config 2) (whl-can-send-config 3)
(whl-can-send-config 4) (whl-can-send-config 5)))
(defun whl-can-ack (refcmd status)
(let ((tx whl-can-tx-r))
(progn
(bufset-u8  tx 0 whl-mark)
(bufset-u8  tx 1 whl-rsp-ack)
(bufset-u8  tx 2 refcmd)
(bufset-u8  tx 3 status)
(bufset-i32 tx 4 0)
(can-send-sid (+ whl-sid-rsp whl-canid) tx))))
(defun whl-can-write (data)
(whl-set-reg (bufget-u8 data 2) (bufget-f32 data 4)))
(defun whl-can-arm (mode)
(cond
((or (= mode 0) (and (= mode 2) (= whl-armed 1))) (setvar 'whl-armed 0))
((and (or (= mode 1) (= mode 2)) (not hc-lock) (not ms-lock)
(whl-input-config) (not whl-brake-hold)
(< (clamp (get-adc-decoded 0) 0.0 1.0) thr-db)
(< (whl-brake-input) thr-db) (> (pick-src) 0)
(< whl-pitch whl-start) (< (abs whl-roll) (- crash-roll 10.0)))
{ (setvar 'whl-rider 0.0) (setvar 'whl-armed 1) })
(t nil)))
(defun whl-can-send-telem ()
(let ((tx whl-can-tx-t))
(progn
(bufset-u8  tx 0 whl-mark)
(bufset-u8  tx 1 whl-rsp-telem)
(bufset-i16 tx 2 (to-i (* whl-pitch 10.0)))
(bufset-i16 tx 4 (to-i (* prate-f 10.0)))
(bufset-u8  tx 6 (bitwise-or (bitwise-or (if (= whl-crash 1) 8 0) (bitwise-or (if (= whl-armed 1) 1 0)
(if (= whl-ctrl 1) 4 0)))
(bitwise-or (if (= whl-brake 1) 16 0) (if (= whl-fault 1) 32 0))))
(bufset-i8  tx 7 (to-i (* whl-out 100.0)))
(can-send-sid (+ whl-sid-rsp whl-canid) tx))))
(defun whl-can-send-attitude ()
(let ((tx whl-can-tx-t) (src (pick-src)))
(progn
(bufset-u8 tx 0 whl-mark)
(bufset-u8 tx 1 whl-rsp-attitude)
(bufset-i16 tx 2 (to-i (* whl-roll 10.0)))
(bufset-u16 tx 4 (if (= src 2) (to-i (clamp (ex-age-ms) 0.0 65535.0))
(if (= src 1) 0 65535)))
(bufset-u8 tx 6 src)
(bufset-u8 tx 7 1)
(can-send-sid (+ whl-sid-rsp whl-canid) tx))))
(defun whl-can-handle (id data)
(if (and (= id (+ whl-sid-cmd whl-canid))
(>= (buflen data) 2)
(= (bufget-u8 data 0) whl-mark))
(let ((cmd (bufget-u8 data 1)))
(cond
((and (= cmd 0x31) (= (buflen data) 8)) (ms-command data))
((and (= cmd 0x30) (= (buflen data) 8)) (hc-command data))
((= cmd whl-cmd-read-all) (whl-can-send-all))
((= cmd whl-cmd-read-reg)
(if (>= (buflen data) 3) (whl-can-send-config (bufget-u8 data 2))))
((= cmd whl-cmd-write-reg)
(if (>= (buflen data) 8)
(progn (whl-can-write data) (whl-can-send-config (bufget-u8 data 2)))))
((= cmd whl-cmd-save) (progn (whl-save) (whl-can-ack whl-cmd-save 1)))
((= cmd whl-cmd-arm)
(if (>= (buflen data) 3) (whl-can-arm (bufget-u8 data 2))))
((= cmd whl-cmd-sub)
(if (>= (buflen data) 3) (setvar 'whl-can-telem-rate (bufget-u8 data 2))))
(t nil)))))
(defun whl-save ()
(progn
(eeprom-store-f 1 whl-start)
(eeprom-store-f 2 whl-end)
(eeprom-store-f 3 whl-damp)
(eeprom-store-f 4 pull-max)
(eeprom-store-f 5 rate-lpf)
(eeprom-store-f 7 pitch-sign)
(eeprom-store-i 8 imu-src)
(eeprom-store-i 9 ex-offset)
(eeprom-store-f 10 stale-ms)
(eeprom-store-f 11 crash-pitch)
(eeprom-store-f 12 crash-roll)
(eeprom-store-f 13 crash-ms)
(eeprom-store-i 14 crash-mode)
(eeprom-store-f 15 letdown-s)
(eeprom-store-i 17 log-en)
(eeprom-store-i 18 log-id)
(eeprom-store-f 19 log-hz)
(eeprom-store-f 20 brk-decel)
(eeprom-store-f 21 brk-off-s)
(eeprom-store-f 22 brk-regen-a)
(eeprom-store-i 16 whl-layout)
(eeprom-store-i 0 whl-magic)))
(def whl-layout2 1464685314)
(def whl-layout3 1464685315)
(def whl-layout 1464685316)
(def ee-fixed 0)
(defun ld-f (slot lo hi dflt)
(let ((v (eeprom-read-f slot)))
(if (and v (>= v lo) (<= v hi)) v (progn (setvar 'ee-fixed 1) dflt))))
(defun ld-i (slot lo hi dflt)
(let ((v (eeprom-read-i slot)))
(if (and v (>= v lo) (<= v hi)) v (progn (setvar 'ee-fixed 1) dflt))))
(defun whl-load ()
(progn
(setvar 'ee-fixed 0)
(setvar 'whl-start   (ld-f 1 0.0 60.0 whl-start))
(setvar 'whl-end     (ld-f 2 10.0 75.0 whl-end))
(setvar 'whl-damp    (ld-f 3 0.0 1.0 whl-damp))
(setvar 'pull-max    (ld-f 4 0.0 1.0 pull-max))
(setvar 'rate-lpf    (ld-f 5 0.01 1.0 rate-lpf))
(setvar 'pitch-sign  (if (< (ld-f 7 -1.0 1.0 pitch-sign) 0.0) -1.0 1.0))
(var lay (eeprom-read-i 16))
(if (and lay (= lay whl-layout))
(progn
(setvar 'brk-decel   (ld-f 20 0.3 6.0 brk-decel))
(setvar 'brk-off-s   (ld-f 21 0.0 10.0 brk-off-s))
(setvar 'brk-regen-a (ld-f 22 0.0 50.0 brk-regen-a)))
(setvar 'ee-fixed 1))
(if (and lay (or (= lay whl-layout) (= lay whl-layout3)))
(progn
(setvar 'log-en (ld-i 17 0 1 log-en))
(setvar 'log-id (ld-i 18 -1 253 log-id))
(setvar 'log-hz (ld-f 19 1.0 100.0 log-hz)))
(setvar 'ee-fixed 1))
(if (and lay (or (= lay whl-layout) (= lay whl-layout3) (= lay whl-layout2)))
(progn
(setvar 'imu-src     (ld-i 8 0 2 imu-src))
(setvar 'ex-offset   (ld-i 9 0 15 ex-offset))
(setvar 'stale-ms    (ld-f 10 20.0 500.0 stale-ms))
(setvar 'crash-pitch (ld-f 11 30.0 90.0 crash-pitch))
(setvar 'crash-roll  (ld-f 12 20.0 90.0 crash-roll))
(setvar 'crash-ms    (ld-f 13 50.0 2000.0 crash-ms))
(setvar 'crash-mode  (ld-i 14 0 1 crash-mode))
(setvar 'letdown-s   (ld-f 15 0.2 5.0 letdown-s)))
(setvar 'ee-fixed 1))
(if (<= whl-end whl-start)
(progn (setvar 'whl-start 25.0) (setvar 'whl-end 45.0) (setvar 'ee-fixed 1)))
(if (= ee-fixed 1) (whl-save))))
