(trap (send-bms))
})
(sleep (/ 1.0 cfg-hz))
}))
((exit-ok (? a)) nil)
(_ (print "link crashed")))
(sleep 1.0)
})
(var cb (car (cdr (trap (conf-get 'can-baud-rate)))))
(print (list "can baud" cb "(2 = 500k)" "id" cfg-my-id
"wifi" (car (cdr (trap (conf-get 'wifi-mode))))
"chan" (car (cdr (trap (wifi-get-chan))))))
})
