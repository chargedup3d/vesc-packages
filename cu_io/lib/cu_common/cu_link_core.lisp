(trap (can-send-sid (pr-sid 0x5E0) b))
(free b)
})
(defun pr-act-recv (data)
(if (and (= (buflen data) 6) (= (bufget-u8 data 0) 0x41) (bridge)) {
(def pr-fwd-seen true)
(sw-do (bufget-u8 data 1) (bufget-u8 data 2))
