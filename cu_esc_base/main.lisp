(import "version.lisp" 'cu-package-version-data)
(read-eval-program cu-package-version-data)
;! Charged Up ESC: enforced drive profiles, neutral and persistent kids caps.
(import "lib/cu_common/cu_esc_core.lisp" 'cu-esc-core)
(import "lib/cu_common/cu_drive_modes.lisp" 'cu-drive-modes)
(read-eval-program cu-esc-core)
(read-eval-program cu-drive-modes)
(import "lib/cu_common/cu_basic_values.lisp" 'cu-basic-values)
(read-eval-program cu-basic-values)
; Shared setup workers; Core supplies profile/hold hooks below.
(import "lib/wheelie_control/motor_setup.lisp" 'core-motor-setup)
(read-eval-program core-motor-setup)
(import "lib/wheelie_control/imu_setup.lisp" 'core-imu-setup)
(read-eval-program core-imu-setup)
(import "lib/wheelie_control/hall_check.lisp" 'core-hall-setup)
(read-eval-program core-hall-setup)
(import "values_setup.lisp" 'core-values-setup)
(read-eval-program core-values-setup)
(import "motor_wizard.lisp" 'core-motor-wizard)
(read-eval-program core-motor-wizard)
(import "lib/cu_common/cu_values_transport.lisp" 'values-transport)
(read-eval-program values-transport)
(def power-proc-sid proc-sid)
(def core-proc-data-rx proc-data-rx)
@const-start
(defun proc-sid (id b) (if (and (= id (+ 0x500 (can-local-id))) (base-power-rx b 1)) nil (power-proc-sid id b)))
(defun proc-data-rx (b) (if (not (base-power-rx b 2)) (if (not (ms-ble-rx b)) (core-proc-data-rx b))))
@const-end
(import "lib/wheelie_control/adc_config/adc_config.bin" 'core-values-native)
(import "motor_wizard/motor_wizard.bin" 'core-motor-native)
@const-start
(def base-version "1.5.1-mode-store")
(def build-id "esc-1.5.1-mode-store")
(defun display-event (ev) nil)
(defun display-stop () nil)
(defun base-status () (print (list "base" base-version drive-mode light-on cruise-on
    (if (> display-ts 0) (secs-since display-ts) -1.0)
    (if (> data-link-ts 0) (secs-since data-link-ts) -1.0)
    (if base-ready 1 0) (if base-kid-on 1 0) base-kid-mph base-kid-w)))
(defun main () {
    (set-print-prefix "ESC-")
    (load-native-lib lib-cmd-proc)
    (ms-init) (im-init) (hc-init)
    (var native-result (trap (load-native-lib core-values-native)))
    (if (and (eq (car native-result) 'exit-ok) (ix native-result 1)) {
        (var probe (trap (ext-ms-adc-save 0 0.0 0.0)))
        (setq ms-save-native-ok (and (eq (car probe) 'exit-ok) (= (ix probe 1) 1)))
    })
    (base-load)
    (trap (bs-load))
    (base-capture)
    (var motor-native (trap (load-native-lib core-motor-native)))
    (if (and base-ready (eq (car motor-native) 'exit-ok) (ix motor-native 1)) {
        (var probe (trap (ext-mw-transaction 0)))
        (setq mw-ready (and (eq (car probe) 'exit-ok) (= (ix probe 1) 1)))
    })
    (setq esc-kid-handler base-kid-frame)
    (setq esc-capabilities 3)
    (apply-drive-mode 1)
    (esc-core-start)
    (spawn ms-loop)
    (spawn hc-loop)
    (loopwhile-thd ("Setup guard" 180) t {
        (core-service-guard) (sleep 0.02)
    })
    ; Keep the last limits through display loss; never silently lift kids caps.
    (loopwhile-thd ("Drive caps" 180) t {
        (apply-drive-mode drive-mode)
        (sleep 0.1)
    })
})
@const-end
(image-save)
(main)
