(trap (ext-disp-cmd 0xbb 0x00 0x00 0x00 0x00 0x00 0x00 0x5a 0xa5))
(trap (ext-disp-cmd 0xa0 0x00 0x10 0x00 0x02 0x00 0x00 0x64 0x3f 0x20 0x05
0x3f 0x3f 0x00 0x00 0x00 0x00 0x00
0x0d 0x35 0x12 0x33 0x39 0x2f 0x27))
(trap (ext-disp-cmd 0xbb 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00))
(trap (ext-disp-cmd 0x13))
(trap (ext-disp-cmd 0x11)) (sleep 0.2)
(trap (ext-disp-cmd 0x29)) (sleep 0.2)
(trap (ext-disp-cmd 0x2c 0x00 0x00 0x00 0x00))
(trap (ext-disp-cmd 0x13)) (sleep 0.02)
(trap (ext-disp-cmd 0x29)) (sleep 0.05)
(var have (> (boot-slot-i 0 0) 0))
(def boot-vertical (and have (= (boot-slot-i 94 0) 1)))
(def boot-orient (if have (boot-slot-i 33 3) 3))
(ext-disp-orientation (if boot-vertical (if (= boot-orient 1) 2 0)
(if (= boot-orient 1) 1 3)))
(def boot-w (if boot-vertical 320 480))
(def boot-h (if boot-vertical 480 320))
(def boot-panel-up true)
})
