(defun boot-reveal () {
(var bright (boot-brightness))
(var start (systime)) (var last start) (var u 0.0) (var prev 106)
(def boot-reveal-frames 0) (def boot-reveal-renders 0) (def boot-reveal-max-gap 0.0)
(loopwhile (< u 1.0) {
(var frame (systime))
(setq u (if (> (secs-since start) 0.9) 1.0 (/ (secs-since start) 0.9)))
(var e (boot-ease u))
(var nx (+ 106 (to-i (* e 172.0))))
(if (> nx prev) {
(trap (img-blit boot-fb img-logo boot-lx boot-ly -1
(list 'clip prev 43 (+ boot-lx nx) (+ boot-ly 65))))
(setq prev nx)
(trap (disp-render boot-fb 0 0))
(def boot-reveal-renders (+ boot-reveal-renders 1))
})
(boot-light (* bright e))
(var gap (secs-since last))
(if (> gap boot-reveal-max-gap) (def boot-reveal-max-gap gap))
(setq last (systime))
(def boot-reveal-frames (+ boot-reveal-frames 1))
(if (< u 1.0) (boot-frame-wait frame 0.033333))
})
(boot-light bright)
(def boot-reveal-seconds (secs-since start))
})
(defun boot-progress-step (shown target)
(if (>= shown target) shown
(+ shown (if (> (- target shown) 4) (/ (- target shown) 4) 1))))
(defun boot-anim () {
(var bw 160) (var bx (/ (- boot-w bw) 2)) (var by (+ boot-ly 90))
(var shown 0) (var target 0) (var finish nil) (var finish-from 0)
(def boot-progress-frames 0)
(trap (img-rectangle boot-fb bx by bw 4 0x202830 '(filled)))
(trap (disp-render boot-fb 0 0))
(loopwhile (or (not boot-done) (< shown bw)) {
(var frame (systime))
(var n (length boot-log))
(setq target (to-i (* bw (/ (to-float (if (> n 12) 12 n)) 12.0))))
(if boot-done {
(if (not finish) { (setq finish (systime)) (setq finish-from shown) })
(setq target (+ finish-from (to-i (* (- bw finish-from)
(boot-ease (/ (secs-since finish) 0.20))))))
} (setq target (to-i (boot-progress-step shown target))))
(if (> target shown) {
(setq shown target)
(trap (img-rectangle boot-fb bx by shown 4 0x5a8cc8 '(filled)))
(trap (disp-render boot-fb 0 0))
(def boot-progress-frames (+ boot-progress-frames 1))
})
(if (or (not boot-done) (< shown bw)) (boot-frame-wait frame 0.04))
