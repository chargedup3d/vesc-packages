@const-start
(defun ring (cx cy r c t2)
(if (tc-p (list 'r cx cy r c t2)) (img-circle fb cx cy r (col c) (list 'thickness t2))))
(defun disc (cx cy r c)
(if (tc-p (list 'd cx cy r c)) (img-circle fb cx cy r (col c) '(filled))))
(defun lineto (x0 y0 x1 y1 c t2)
(if (tc-p (list 'l x0 y0 x1 y1 c t2))
(img-line fb x0 y0 x1 y1 (col c) (list 'thickness t2))))
(defun draw-status () {
(var slot (strip-slot))
(var own (and (= page 0) (>= cfg-status-x 0)))
(var x (if own (clampx cfg-status-x 0 (- fb-w 152)) (ix slot 0)))
(var y (if (and (= page 0) (>= cfg-status-y 0)) (clampx cfg-status-y 0 (- fb-h 30)) (ix slot 1)))
(var blink (< (mod (to-i (* (secs-since 0) 2.0)) 2) 1))
(var l (if cfg-status-test true st-turn-l))
(var r (if cfg-status-test true st-turn-r))
(var b (if cfg-status-test true st-beam))
(var bk (if cfg-status-test true st-brake))
(cond
((> d-fault 0) {
(var s (fault-name d-fault))
(if (> (ix (tdim-k font-sm (str-clean s)) 0) 130)
(setq s (str-merge "FAULT " (str-from-n d-fault "%d"))))
(rbox x (+ y 2) 140 26 5 0xFF0000)
(txt-c (+ x 70) (base-c font-sm (+ y 15)) 0x000000 font-sm s)
})
((not (strip-on)) nil)
(t {
(st-arrow x y 30 (if (and l blink) 0x00FF00 0x1E3A1E) true)
(st-arrow (+ x 34) y 30 (if (and r blink) 0x00FF00 0x1E3A1E) false)
(st-beam-icon (+ x 74) (+ y 2) 26 (if b 0x0000FF 0x1A1A3A))
(rbox (+ x 110) (+ y 6) 30 18 4 (if bk 0xFF0000 0x3A1A1A))
}))
(if (and (not d-online) (= d-fault 0) blink)
(rbox (+ x 143) (+ y 11) 8 8 4 0xFF0000))
})
(defun draw-instrument () {
(var ls (cdr sl-src))
(var lc (cdr sl-col))
(looprange i 0 3 (instr-left i (ix ls i) (ix lc i)))
(var rs (list (ix sl-src 4) (ix sl-src 5)))
(var rc (list (ix sl-col 4) (ix sl-col 5)))
(looprange i 0 2 (instr-right i (ix rs i) (ix rc i)))
(big-stack 240 (+ 129 (strip-drop)) cfg-arc-src cfg-acc-arc)
(rule-h 12 262 456 (c-rule))
(looprange i 0 3 (instr-foot i (ix sl-src (+ i 6)) (ix sl-col (+ i 6))))
})
(defun instr-left (i sc c) (tc-block (qv sc) (fn () (if (!= sc 15) {
(var y0 (+ 10 (* i 82)))
(draw-icon sc 8 y0 22 c)
(txt 36 (+ y0 18) c font-sm (src-label sc))
(txt 8 (+ y0 64) cfg-c-value font-lg (src-fmt sc (src-dec sc)))
(txt-r 128 (+ y0 64) cfg-c-unit font-sm (src-unit sc))
(box 8 (+ y0 72) 120 2 c)
}))))
(defun instr-right (i sc c) (tc-block (qv sc) (fn () (if (!= sc 15) {
(var y0 (+ 24 (strip-drop) (* i 118)))
(txt-r 472 (+ y0 18) c font-sm (src-label sc))
(txt-r 472 (+ y0 64) cfg-c-value font-lg (src-fmt sc (src-dec sc)))
(box 352 (+ y0 84) 120 2 c)
}))))
(defun instr-foot (i sc c) (tc-block (qv sc) (fn () (if (!= sc 15) {
(var cx (+ 80 (* i 160)))
(txt-c cx 280 c font-sm (src-label sc))
(txt-c cx 306 cfg-c-value font-sm
(str-merge (src-fmt sc (src-dec sc)) " " (src-unit sc)))
}))))
(defun stat-block (x y w src accent) (tc-block (qv src) (fn () (stat-block-body x y w src accent))))
(defun stat-block-body (x y w src accent) {
(if (!= src 15) {
(if (>= cfg-lbl-slot 2)
(txt x y accent font-sm (src-label src)))
(txt x (+ y 44) cfg-c-value font-lg (src-fmt src (src-dec src)))
(if (or (= cfg-lbl-slot 1) (= cfg-lbl-slot 3))
(txt-r (+ x w) (+ y 44) cfg-c-unit font-sm (src-unit src)))
})
})
(defun stat-c (cx y src accent) (tc-block (qv src) (fn () (stat-c-body cx y src accent))))
(defun stat-c-body (cx y src accent) {
(if (!= src 15) {
(if (>= cfg-lbl-slot 2)
(txt-c cx y accent font-sm (src-label src)))
(txt-c cx (+ y 42) cfg-c-value font-md
(if (or (= cfg-lbl-slot 1) (= cfg-lbl-slot 3))
(str-merge (src-fmt src (src-dec src)) " "
(src-unit src))
(src-fmt src (src-dec src))))
})
})
(defun frac (src vmin vmax) {
(var d (- vmax vmin))
(if (< (abs d) 0.001) 0.0
(clamp01 (/ (- (src-val src) vmin) d)))
})
(defun meter-h (x y w h src vmin vmax accent segs) (tc-block (qv src) (fn () (meter-h-body x y w h src vmin vmax accent segs))))
(defun meter-h-body (x y w h src vmin vmax accent segs)
(if (!= src 15) {
(var f (frac src vmin vmax))
(var sw (/ (- w 8) segs))
(var lit (to-i (* segs f)))
(looprange i 0 segs
(rbox (+ x 4 (* i sw)) (+ y 3) (- sw 3) (- h 6) 2
(if (< i lit) accent (c-meter))))
}))
(defun meter-v (x y w h src vmin vmax accent segs) (tc-block (qv src) (fn () (meter-v-body x y w h src vmin vmax accent segs))))
(defun meter-v-body (x y w h src vmin vmax accent segs)
(if (!= src 15) {
(var f (frac src vmin vmax))
(var sh (/ (- h 6) segs))
(var lit (to-i (* segs f)))
(looprange i 0 segs
(rbox x (- (+ y h -4) (* (+ i 1) sh)) w (- sh 3) 2
(if (< i lit) accent (c-meter))))
}))
(defun big-num (cx cy src accent) (tc-block (qv src) (fn () (big-num-body cx cy src accent))))
(defun big-num-body (cx cy src accent)
(if (!= src 15) {
(txt-c cx (- cy 62) accent font-sm (src-unit src))
(txt-c cx (+ cy 34) cfg-c-value font-xl
(src-fmt src (src-dec src)))
}))
(defun c-rule () (if (= theme-bg 0) 0x004040 theme-pan))
(defun c-meter () (if (= theme-bg 0) 0x1A1A1A theme-pan))
(defun rule-h (x y w c) (box x y w 2 c))
(defun draw-tacho () {
(meter-h 8 10 464 34 cfg-tl-src cfg-tl-min cfg-tl-max cfg-acc-tl 32)
(if (!= cfg-tl-src 15)
(txt 12 68 cfg-acc-tl font-sm (src-label cfg-tl-src)))
(big-num 240 160 cfg-arc-src cfg-acc-arc)
(stat-c 80 246 cfg-tr-src cfg-acc-tr)
(stat-c 240 246 cfg-bl-src cfg-acc-bl)
(stat-c 400 246 cfg-br-src cfg-acc-br)
})
(def arc-prev nil)
(def arc-w1 -1) (def arc-w3 -1) (def arc-w4 -1)
(def arc-row-ss nil)
(def arc-lbl-w nil)
(def arc-row-wide nil)
(defun arc-geom () {
(var lh1 (line-h font-lg))
(var lhu (line-h font-md))
(var lh2 (line-h font-md))
(var t1 (- arc-cy 10 (/ lh1 2)))
(var g1 10) (var g2 22) (var g3 12)
(var room (- (- arc-bar-y 4) (+ t1 lh1)))
(var need (+ lhu lh2 lh2 g1 g2 g3))
(if (> need room) {
(var spare (- room (+ lhu lh2 lh2)))
(if (< spare 9) (setq spare 9))
(setq g1 (/ (* g1 spare) 44))
(setq g2 (/ (* g2 spare) 44))
(setq g3 (/ (* g3 spare) 44))
(if (< g1 3) (setq g1 3))
(if (< g2 3) (setq g2 3))
(if (< g3 3) (setq g3 3))
})
(var t2 (+ t1 lh1 g1))
(var t3 (+ t2 lhu g2))
(var t4 (+ t3 lh2 g3))
(list t1 t3 t4 lh1 lh2)
})
(defun arc-rows () (if (bms-live)
(list cfg-tl-src cfg-tr-src cfg-bl-src cfg-br-src 8)
(list cfg-tl-src cfg-tr-src cfg-bl-src cfg-br-src)))
(defun arc-q (v d) (to-i (* v (cond ((= d 0) 1.0) ((= d 1) 10.0) (t 100.0)))))
(defun arc-fields () {
(var src cfg-arc-src)
(var pct (arc-soc))
(var ss (arc-rows))
(list (arc-q (src-val src) (src-dec src))
(to-i (* (frac src cfg-arc-min cfg-arc-max) 270.0))
(to-i (* d-volt 10.0))
(to-i (* pct 100.0))
(to-i (* (- arc-bar-w 6) pct))
(map (fn (r) (arc-q (src-val r) (src-dec r))) ss)
(length ss))
})
(defun arc-wipe (cx y w h c) (box (- cx (/ w 2)) y w h c))
(defun arc-txt (ty f s prev) {
(var k (str-clean s))
(var w (ix (tdim-k f k) 0))
(if (>= prev 0)
(arc-wipe arc-cx ty (+ (if (> w prev) w prev) 8) (line-h f) theme-bg))
(txt-k (- arc-cx (/ w 2)) (base-t f ty) theme-fg f k)
w
})
(defun arc-update (was now) {
(var g (arc-geom))
(var t1 (ix g 0)) (var t3 (ix g 1)) (var t4 (ix g 2))
(var lh1 (ix g 3)) (var lh2 (ix g 4))
(var src cfg-arc-src)
(if (!= (ix was 1) (ix now 1)) {
(var f (frac src cfg-arc-min cfg-arc-max))
(arc arc-cx arc-cy arc-r 135 45 theme-bg (+ arc-th 4))
(arc arc-cx arc-cy arc-r 135 45 arc-track arc-th)
(if (> f 0.005)
(arc arc-cx arc-cy arc-r 135 (+ 135.0 (* f 270.0))
(arc-fill-col f) arc-th))
})
(if (!= (ix was 0) (ix now 0)) {
(def arc-w1 (arc-txt t1 font-lg (src-fmt src (src-dec src)) arc-w1))
})
(if (!= (ix was 2) (ix now 2)) {
(def arc-w3 (arc-txt t3 font-md (str-merge (str-from-n d-volt "%.1f") "V") arc-w3))
})
(if (!= (ix was 3) (ix now 3)) {
(def arc-w4 (arc-txt t4 font-md (str-merge (str-from-n (* (arc-soc) 100.0) "%.0f") "%") arc-w4))
})
(if (or (!= (ix was 6) (ix now 6)) (not-eq (arc-rows) arc-row-ss))
(fb-redraw)
{
(var ss (arc-rows))
(var rn (length ss))
(var ix1 (+ arc-pan-x 6))
(var ix2 (- (+ arc-pan-x arc-pan-w) 6))
(var ih (- arc-pan-h 12))
(var rh (line-h font-md))
(var gap (/ (- ih (* rh rn)) (+ rn 1)))
(var av (ix was 5))
(var bv (ix now 5))
(looprange i 0 rn {
(if (and (!= (ix av i) (ix bv i)) (!= (ix ss i) 15)) {
(var cy (+ arc-pan-y 6 (* gap (+ i 1)) (* rh i) (/ rh 2)))
(arc-row-update i cy ix1 ix2 rh (ix ss i))
})
})
})
(if (!= (ix was 4) (ix now 4)) {
(var pct (arc-soc))
(rbox arc-bar-x arc-bar-y arc-bar-w arc-bar-h 6 arc-track)
(var iw (ix now 4))
(if (> iw 3)
(rbox (+ arc-bar-x 3) (+ arc-bar-y 3) iw (- arc-bar-h 6) 4
(arc-batt-col (* pct 100.0))))
})
})
(defun arc-row-update (i cy x1 x2 rh src) {
(var lw (ix arc-lbl-w i))
(var v (src-fmt src (src-dec src)))
(var k (str-clean (str-merge v (src-unit src))))
(var w (ix (tdim-k font-md k) 0))
(if (> (+ lw w 16) (- x2 x1)) {
(setq k (str-clean v))
(setq w (ix (tdim-k font-md k) 0))
})
(var vx (+ x1 lw 2))
(var fits (>= (- x2 w) vx))
(var y (- cy (/ rh 2)))
(if (and fits (not (ix arc-row-wide i)))
(box vx y (+ (- x2 vx) 2) rh theme-acc)
{
(box x1 y (+ (- x2 x1) 2) rh theme-acc)
(txt-lc x1 cy theme-ofg2 font-sm (src-label src))
})
(txt-k (- x2 w) (base-c font-md cy) (arc-stat-col src) font-md k)
(setix arc-row-wide i (not fits))
})
(defun draw-arc () {
(var now (arc-fields))
(def fb-changed (or fb-entering (not-eq now arc-prev)))
(if (or fb-entering (eq arc-prev nil))
(arc-paint-all)
(arc-update arc-prev now))
(def arc-prev now)
})
(defun draw-flank () {
(if (!= cfg-tl-src 15)
(txt-cs 40 24 cfg-acc-tl font-sm (src-label cfg-tl-src)))
(meter-v 14 34 52 244 cfg-tl-src cfg-tl-min cfg-tl-max cfg-acc-tl 15)
(if (!= cfg-tr-src 15)
(txt-cs 440 24 cfg-acc-tr font-sm (src-label cfg-tr-src)))
(meter-v 414 34 52 244 cfg-tr-src cfg-tr-min cfg-tr-max cfg-acc-tr 15)
(big-num 240 142 cfg-arc-src cfg-acc-arc)
(stat-c 160 266 cfg-bl-src cfg-acc-bl)
(stat-c 320 266 cfg-br-src cfg-acc-br)
})
(defun draw-diag () {
(txt 12 26 cfg-acc-arc font-sm "DIAGNOSTIC")
(rule-h 12 32 456 cfg-acc-arc)
(var ss k-diag)
(looprange i 0 12 {
(var x (+ 12 (* (mod i 3) 156)))
(var y (+ 66 (* (/ i 3) 62)))
(var sc (ix ss i))
(txt x y cfg-acc-tr font-sm (src-label sc))
(txt x (+ y 30) cfg-c-value font-sm
(str-merge (src-fmt sc (src-dec sc)) " " (src-unit sc)))
})
(if (> d-fault 0)
(txt 12 312 0xFF0000 font-sm (fault-name d-fault))
(txt 12 312 0x00FF00 font-sm "OK"))
})
(defun src-esc2 (s) (cond
((= s 1) 16) ((= s 2) 17) ((= s 3) 18)
((= s 7) 7)  (t s)))
(defun dual-col (x w label second accent) (tc-block (list (map (fn (i) (qv (if second (src-esc2 (ix sl-src i)) (ix sl-src i)))) (list 1 2 3)) (q100 (if second e2-duty d-duty))) (fn () (dual-col-body x w label second accent))))
(defun dual-col-body (x w label second accent) {
(txt-c (+ x (/ w 2)) 34 accent font-sm label)
(box x 42 w 2 accent)
(looprange i 0 3 {
(var sc (ix sl-src (+ i 1)))
(if (!= sc 15) {
(var use (if second (src-esc2 sc) sc))
(var y (+ 84 (* i 72)))
(txt x y cfg-c-value font-lg
(src-fmt use (src-dec use)))
(txt-r (+ x w) y cfg-c-unit font-sm (src-unit use))
(txt x (+ y 24) accent font-sm (src-label use))
})
})
(var d (if second e2-duty d-duty))
(var f (clamp01 (abs d)))
(if (> f 0.02) (rbox x 256 (to-i (* w f)) 8 4 accent) (tc-skip))
})
(defun gauge (cx cy r src vmin vmax c thick) (tc-block (qv src) (fn () (gauge-body cx cy r src vmin vmax c thick))))
(defun gauge-body (cx cy r src vmin vmax c thick) {
(arc cx cy r 135 45 theme-pan thick)
(var f (frac src vmin vmax))
(if (> f 0.01) (arc cx cy r 135 (+ 135.0 (* f 270.0)) c thick) (tc-skip))
})
(defun draw-twin () {
(var a cfg-arc-src)
(var b cfg-tl-src)
(var r (if (strip-on) 92 100))
(gauge 116 (+ 116 (strip-drop)) r a cfg-arc-min cfg-arc-max cfg-acc-arc 14)
(gauge 364 (+ 116 (strip-drop)) r b cfg-tl-min cfg-tl-max cfg-acc-tl 14)
(med-stack 116 (+ 116 (strip-drop)) a cfg-acc-arc)
(med-stack 364 (+ 116 (strip-drop)) b cfg-acc-tl)
(rule-h 12 236 456 (c-rule))
(var ss (list cfg-tr-src cfg-bl-src cfg-br-src))
(var cs (list cfg-acc-tr cfg-acc-bl cfg-acc-br))
(looprange i 0 3 {
(var sc (ix ss i))
(if (!= sc 15) (stat-c (+ 80 (* i 160)) 266 sc (ix cs i)))
})
})
(defun free-lbl (src which) (cond
((= which 1) (src-unit src))
((= which 2) (src-label src))
((= which 3) (str-merge (src-label src) " " (src-unit src)))
(t "")))
(defun free-val (x y src accent) (tc-block (qv src) (fn () (free-val-body x y src accent))))
(defun free-val-body (x y src accent) {
(if (!= src 15) {
(var yy y)
(if (> cfg-lbl-slot 0) {
(txt x (base-t font-sm yy) accent font-sm
(free-lbl src cfg-lbl-slot))
(setq yy (+ yy (line-h font-sm) 2))
})
(txt x (base-t font-lg yy) cfg-c-value font-lg
(src-fmt src (src-dec src)))
})
})
(defun free-main (x y src accent) (tc-block (qv src) (fn () (free-main-body x y src accent))))
(defun free-main-body (x y src accent) {
(if (!= src 15) {
(var bw (tw font-xl "888"))
(var yy y)
(if (> cfg-lbl-main 0) {
(var l (free-lbl src cfg-lbl-main))
(txt (+ x (/ (- bw (tw font-sm l)) 2))
(base-t font-sm yy) accent font-sm l)
(setq yy (+ yy (line-h font-sm) 2))
})
(var v (src-fmt src (src-dec src)))
(txt (+ x (/ (- bw (tw font-xl v)) 2))
(base-t font-xl yy) cfg-c-value font-xl v)
})
})
(defun pol-x (cx r a) (+ cx (to-i (* r (cos (* a 0.01745329))))))
(defun pol-y (cy r a) (+ cy (to-i (* r (sin (* a 0.01745329))))))
(defun dial-tick (cx cy a r0 r1 c t2)
(if (tc-p (list 'dt cx cy a r0 r1 c t2))
(img-line fb (pol-x cx r0 a) (pol-y cy r0 a)
(pol-x cx r1 a) (pol-y cy r1 a) (col c) (list 'thickness t2))))
(defun free-dial () {
(var cx cfg-dial-x) (var cy cfg-dial-y) (var r cfg-dial-r)
(var f (frac cfg-arc-src cfg-arc-min cfg-arc-max))
(looprange i 0 21 {
(var a (+ 135.0 (* (to-float i) 13.5)))
(var maj (= (mod i 2) 0))
(dial-tick cx cy a (- r (if maj 18 8)) r
(if maj theme-fg theme-fg2) (if maj 4 2))
})
(if (> r 80) {
(var span (- cfg-arc-max cfg-arc-min))
(looprange i 0 6 {
(var a (+ 135.0 (* (to-float i) 54.0)))
(var v (+ cfg-arc-min (* span (/ (to-float i) 5.0))))
(txt-c (pol-x cx (- r 44) a)
(base-c font-sm (pol-y cy (- r 44) a))
theme-fg font-sm (fmt v 0))
})
})
(arc cx cy (- r 26) 4.5 45.0 theme-bad 6)
(var a (+ 135.0 (* f 270.0)))
(if (tc-p (list 'needle cx cy r a cfg-acc-arc theme-bg))
(needle-draw cx cy r a cfg-acc-arc theme-bg))
})
(defun needle-draw (cx cy r a c bg) (needle-draw-to fb cx cy r a c bg))
(defun needle-draw-to (g cx cy r a c bg) {
(img-triangle g
(pol-x cx (- r 30) a) (pol-y cy (- r 30) a)
(pol-x cx 7 (+ a 90.0)) (pol-y cy 7 (+ a 90.0))
(pol-x cx 7 (- a 90.0)) (pol-y cy 7 (- a 90.0))
(col c) '(filled))
(img-circle g cx cy 9 (col c) '(filled))
(img-circle g cx cy 4 (col bg) '(filled))
})
(defun free-bar () {
(var x (clampx cfg-bar-x 0 (- fb-w 24)))
(var y (clampx cfg-bar-y 0 (- fb-h 20)))
(var w (clampx cfg-bar-w 24 (- fb-w x)))
(var f (frac cfg-bar-fill cfg-bar-min cfg-bar-max))
(rbox x y w 20 6 theme-pan)
(var iw (to-i (* (- w 6) f)))
(if (> iw 3)
(rbox (+ x 3) (+ y 3) iw 14 4 cfg-acc-batt) (tc-skip))
})
(defun draw-free () {
(if cfg-show-dial (free-dial))
(if cfg-show-gauge
(gauge cfg-g-x cfg-g-y cfg-g-r cfg-arc-src cfg-arc-min cfg-arc-max
cfg-acc-arc 14))
(if cfg-show-main (free-main cfg-main-x cfg-main-y cfg-arc-src cfg-acc-arc))
(if cfg-show-tl (free-val cfg-tl-x cfg-tl-y cfg-tl-src cfg-acc-tl))
(if cfg-show-tr (free-val cfg-tr-x cfg-tr-y cfg-tr-src cfg-acc-tr))
(if cfg-show-bl (free-val cfg-bl-x cfg-bl-y cfg-bl-src cfg-acc-bl))
(if cfg-show-br (free-val cfg-br-x cfg-br-y cfg-br-src cfg-acc-br))
(if cfg-show-s6 (free-val cfg-s6-x cfg-s6-y cfg-s6-src cfg-acc-s6))
(if cfg-show-s7 (free-val cfg-s7-x cfg-s7-y cfg-s7-src cfg-acc-s7))
(if cfg-show-s8 (free-val cfg-s8-x cfg-s8-y cfg-s8-src cfg-acc-s8))
(if (and cfg-show-batt (!= cfg-bar-fill 15)) (free-bar))
})
(def arc-cx 160) (def arc-cy 160) (def arc-r 125) (def arc-th 16)
(def arc-pan-x 325) (def arc-pan-y 12)
(def arc-pan-w 150) (def arc-pan-h 280)
(def arc-bar-x 5) (def arc-bar-y 294)
(def arc-bar-w 300) (def arc-bar-h 20)
(def arc-track 0x333355)
(defun asc-of (f) {
(var r (trap (ttf-ascender f)))
(if (eq (car r) 'exit-ok) (car (cdr r)) 16.0)
})
(defun desc-of (f) {
(var r (trap (ttf-descender f)))
(if (eq (car r) 'exit-ok) (car (cdr r)) -4.0)
})
(defun lh-of (f) {
(var r (trap (ttf-line-height f)))
(if (eq (car r) 'exit-ok) (car (cdr r)) 20.0)
})
(defun base-t (f ty) (+ ty (to-i (asc-of f))))
(defun base-c (f cy)
(+ cy (to-i (+ (/ (lh-of f) 2.0) (desc-of f)))))
(defun line-h (f) {
(var v (to-i (lh-of f)))
(if (< v 1) 20 v)
})
(defun txt-ct (cx ty c f s) (txt-a cx (base-t f ty) c f s 1))
(defun txt-lc (x cy c f s) (txt x (base-c f cy) c f s))
(defun txt-rc (rx cy c f s) (txt-a rx (base-c f cy) c f s 2))
(defun arc-stat-col (src) {
(var v (src-val src))
(cond
((or (= src 1) (= src 2) (= src 8) (= src 16)
(= src 17) (= src 20) (= src 21)) {
(var w1 (if (= cfg-unit-temp 1) 45.0 113.0))
(var w2 (if (= cfg-unit-temp 1) 70.0 158.0))
(cond ((< v w1) theme-good-a)
((< v w2) theme-warn-a)
(t theme-bad-a))
})
((or (= src 3) (= src 18) (= src 19) (= src 22) (= src 25))
(cond ((< (abs v) 30.0) theme-good-a)
((< (abs v) 60.0) theme-warn-a)
(t theme-bad-a)))
(t theme-ofg))
})
(defun arc-fill-col (f) (cond
((>= f 0.85) (pick-variant 0xff3344 0x801822 theme-bg))
((>= f 0.60) (pick-variant 0xffaa00 0x885500 theme-bg))
(t           (pick-variant 0x00cc66 0x005530 theme-bg))))
(defun arc-batt-col (pct) (cond
((> pct 55.0) theme-good)
((> pct 25.0) theme-warn)
(t theme-bad)))
(defun tw (f s) (ix (tdim f s) 0))
(defun arc-stat (cy x1 x2 src) {
(if (!= src 15) {
(var lbl (src-label src))
(var v (src-fmt src (src-dec src)))
(var full (str-merge v (src-unit src)))
(var s (if (> (+ (tw font-sm lbl) (tw font-md full) 16) (- x2 x1))
v full))
(txt-lc x1 cy theme-ofg2 font-sm lbl)
(txt-rc x2 cy (arc-stat-col src) font-md s)
})
})
(defun arc-soc () (if (bms-live) (clamp01 (/ bms-soc 100.0)) (clamp01 d-soc)))
(defun arc-paint-all () {
(var src cfg-arc-src)
(var f (frac src cfg-arc-min cfg-arc-max))
(arc arc-cx arc-cy arc-r 135 45 arc-track arc-th)
(if (> f 0.005)
(arc arc-cx arc-cy arc-r 135 (+ 135.0 (* f 270.0))
(arc-fill-col f) arc-th))
(var lh1 (line-h font-lg))
(var lhu (line-h font-md))
(var lh2 (line-h font-md))
(var t1 (- arc-cy 10 (/ lh1 2)))
(def arc-w1 (arc-txt t1 font-lg (src-fmt src (src-dec src)) -1))
(var g1 10) (var g2 22) (var g3 12)
(var room (- (- arc-bar-y 4) (+ t1 lh1)))
(var need (+ lhu lh2 lh2 g1 g2 g3))
(if (> need room) {
(var spare (- room (+ lhu lh2 lh2)))
(if (< spare 9) (setq spare 9))
(setq g1 (/ (* g1 spare) 44))
(setq g2 (/ (* g2 spare) 44))
(setq g3 (/ (* g3 spare) 44))
(if (< g1 3) (setq g1 3))
(if (< g2 3) (setq g2 3))
(if (< g3 3) (setq g3 3))
})
(var t2 (+ t1 lh1 g1))
(txt-ct arc-cx t2 theme-fg font-md (src-unit src))
(var t3 (+ t2 lhu g2))
(def arc-w3 (arc-txt t3 font-md (str-merge (str-from-n d-volt "%.1f") "V") -1))
(var t4 (+ t3 lh2 g3))
(def arc-w4 (arc-txt t4 font-md (str-merge (str-from-n (* (arc-soc) 100.0) "%.0f") "%") -1))
(rbox arc-pan-x arc-pan-y arc-pan-w arc-pan-h 10 theme-acc)
(var ss (if (bms-live)
(list cfg-tl-src cfg-tr-src cfg-bl-src cfg-br-src 8)
(list cfg-tl-src cfg-tr-src cfg-bl-src cfg-br-src)))
(var rn (length ss))
(var ix1 (+ arc-pan-x 6))
(var ix2 (- (+ arc-pan-x arc-pan-w) 6))
(var ih (- arc-pan-h 12))
(var rh (line-h font-md))
(var gap (/ (- ih (* rh rn)) (+ rn 1)))
(looprange i 0 rn
(arc-stat (+ arc-pan-y 6 (* gap (+ i 1)) (* rh i) (/ rh 2))
ix1 ix2 (ix ss i)))
(def arc-row-ss ss)
(def arc-lbl-w (map (fn (r) (if (= r 15) 0 (tw font-sm (src-label r)))) ss))
(def arc-row-wide (map (fn (r) t) ss))
(var pct (arc-soc))
(rbox arc-bar-x arc-bar-y arc-bar-w arc-bar-h 6 arc-track)
(var iw (to-i (* (- arc-bar-w 6) pct)))
(if (> iw 3)
(rbox (+ arc-bar-x 3) (+ arc-bar-y 3) iw (- arc-bar-h 6) 4
(arc-batt-col (* pct 100.0))))
})
(def arcv-cx 160) (def arcv-cy 145) (def arcv-r 110)
(def arcv-bar-x 10) (def arcv-bar-y 280)
(def arcv-bar-w 300) (def arcv-bar-h 24)
(def arcv-pan-x 10) (def arcv-pan-y 306)
(def arcv-pan-w 300) (def arcv-pan-h 150)
(defun arcv-stat (cx ty src) {
(if (!= src 15) {
(txt-ct cx ty theme-ofg2 font-sm (src-label src))
(txt-ct cx (+ ty 18) (arc-stat-col src) font-md
(str-merge (src-fmt src (src-dec src)) (src-unit src)))
})
})
(defun draw-arc-v () {
(var src cfg-arc-src)
(var f (frac src cfg-arc-min cfg-arc-max))
(arc arcv-cx arcv-cy arcv-r 135 45 arc-track arc-th)
(if (> f 0.005)
(arc arcv-cx arcv-cy arcv-r 135 (+ 135.0 (* f 270.0))
(arc-fill-col f) arc-th) (tc-skip))
(var lh1 (line-h font-lg))
(var lhu (line-h font-md))
(var t1 (- arcv-cy 8 (/ lh1 2)))
(txt-ct arcv-cx t1 theme-fg font-lg (src-fmt src (src-dec src)))
(var g1 18) (var g2 12) (var g3 12)
(var room (- (- arcv-bar-y 4) (+ t1 lh1)))
(if (> (+ (* 3 lhu) g1 g2 g3) room) {
(var spare (- room (* 3 lhu)))
(if (< spare 9) (setq spare 9))
(setq g1 (/ (* g1 spare) 42))
(setq g2 (/ (* g2 spare) 42))
(setq g3 (/ (* g3 spare) 42))
(if (< g1 3) (setq g1 3))
(if (< g2 3) (setq g2 3))
(if (< g3 3) (setq g3 3))
})
(var t2 (+ t1 lh1 g1))
(txt-ct arcv-cx t2 theme-fg font-md (src-unit src))
(var t3 (+ t2 lhu g2))
(txt-ct arcv-cx t3 theme-fg font-md
(str-merge (str-from-n d-volt "%.1f") "V"))
(var t4 (+ t3 lhu g3))
(txt-ct arcv-cx t4 theme-fg font-md
(str-merge (str-from-n (* (arc-soc) 100.0) "%.0f") "%"))
(var pct (arc-soc))
(rbox arcv-bar-x arcv-bar-y arcv-bar-w arcv-bar-h 6 arc-track)
(var iw (to-i (* (- arcv-bar-w 6) pct)))
(if (> iw 3)
(rbox (+ arcv-bar-x 3) (+ arcv-bar-y 3) iw (- arcv-bar-h 6) 4
(arc-batt-col (* pct 100.0))) (tc-skip))
(rbox arcv-pan-x arcv-pan-y arcv-pan-w arcv-pan-h 12 theme-acc)
(if (bms-live) {
(var cw (/ arcv-pan-w 3))
(var c1 (+ arcv-pan-x (/ cw 2)))
(var c2 (+ arcv-pan-x cw (/ cw 2)))
(var c3 (+ arcv-pan-x (* cw 2) (/ cw 2)))
(arcv-stat c1  (+ arcv-pan-y 10) cfg-tl-src)
(arcv-stat c2  (+ arcv-pan-y 10) cfg-tr-src)
(arcv-stat c3  (+ arcv-pan-y 10) 8)
(var mid (+ arcv-pan-x (/ arcv-pan-w 2)))
(arcv-stat (- mid (/ cw 2)) (+ arcv-pan-y 80) cfg-bl-src)
(arcv-stat (+ mid (/ cw 2)) (+ arcv-pan-y 80) cfg-br-src)
} {
(var qx (+ arcv-pan-x (/ arcv-pan-w 4)))
(var qx2 (+ arcv-pan-x (/ (* arcv-pan-w 3) 4)))
(arcv-stat qx  (+ arcv-pan-y 10) cfg-tl-src)
(arcv-stat qx2 (+ arcv-pan-y 10) cfg-tr-src)
(arcv-stat qx  (+ arcv-pan-y 80) cfg-bl-src)
(arcv-stat qx2 (+ arcv-pan-y 80) cfg-br-src)
})
})
(defun hdr-item (cx src accent) (tc-block (qv src) (fn () (hdr-item-body cx src accent))))
(defun hdr-item-body (cx src accent) {
(if (!= src 15) {
(txt-c cx 20 accent font-sm (src-label src))
(txt-c cx 46 cfg-c-value font-sm
(str-merge (src-fmt src (src-dec src)) " "
(src-unit src)))
})
})
(defun draw-header () {
(var ss (cdr sl-src))
(var cs (cdr sl-col))
(looprange i 0 4 (hdr-item (+ 60 (* i 120)) (ix ss i) (ix cs i)))
(rule-h 8 58 464 (c-rule))
(big-num 240 166 cfg-arc-src cfg-acc-arc)
(meter-h 8 268 464 44 cfg-bar-fill cfg-bar-min cfg-bar-max
cfg-acc-batt 26)
})
(defun draw-dual () {
(dual-col 8 130 "MOTOR 1" false cfg-acc-tl)
(dual-col 342 130 "MOTOR 2" true cfg-acc-tr)
(big-stack 240 148 cfg-arc-src cfg-acc-arc)
(var pct (* d-soc 100.0))
(var ac (cond ((< pct 15.0) 0xFF0000) ((< pct 35.0) 0xFFFF00)
(t cfg-acc-batt)))
(var lit (to-i (* 16 (clamp01 (/ pct 100.0)))))
(looprange i 0 16
(if (< i lit) (rbox (+ 150 (* i 12)) 286 9 22 2 ac)))
(txt-r 468 308 ac font-sm (str-merge (fmt pct 0) "%"))
})
(defun vblk (x y w src accent) {
(if (!= src 15) {
(draw-icon src x y 22 accent)
(if (>= cfg-lbl-slot 2)
(txt (+ x 28) (+ y 18) accent font-sm (src-label src)))
(txt x (+ y 64) cfg-c-value font-lg
(src-fmt src (src-dec src)))
(txt-r (+ x w) (+ y 64) cfg-c-unit font-sm (src-unit src))
(box x (+ y 80) w 2 accent)
})
})
(defun vp-stack () {
(big-stack 160 (+ 108 (strip-drop)) cfg-arc-src cfg-acc-arc)
(rule-h 12 184 296 (c-rule))
(var ss (cdr sl-src))
(var cs (cdr sl-col))
(looprange i 0 4
(vblk (+ 12 (* (mod i 2) 152)) (+ 200 (* (/ i 2) 94)) 140
(ix ss i) (ix cs i)))
(rule-h 12 392 296 (c-rule))
(looprange i 0 3 {
(var sc (ix k-foot i))
(var cx (+ 64 (* i 96)))
(txt-c cx 420 cfg-acc-arc font-sm (src-label sc))
(txt-c cx 452 cfg-c-value font-sm
(str-merge (src-fmt sc (src-dec sc)) " " (src-unit sc)))
})
})
(defun vp-tacho () {
(var f (frac cfg-tl-src cfg-tl-min cfg-tl-max))
(looprange i 0 12 {
(var c (cond ((< i 7) 0x00FF00) ((< i 10) 0xFFFF00) (t 0xFF0000)))
(rbox (+ 10 (* i 25)) 8 21 20 3
(if (< (/ (to-float i) 12.0) f) c (c-meter)))
})
(var mc (cond ((= cfg-mode 1) 0x00FF00) ((= cfg-mode 2) 0x00FFFF)
(t 0xFF8000)))
(if (gear-locked (- cfg-mode 1)) (setq mc 0x808080))
(rbox 10 36 60 30 6 mc)
(txt-c 40 58 0x000000 font-sm (mode-name cfg-mode))
(if (!= cfg-tl-src 15)
(txt 82 52 cfg-acc-tl font-sm (src-label cfg-tl-src)))
(meter-h 82 60 226 22 cfg-tl-src cfg-tl-min cfg-tl-max cfg-acc-tl 14)
(big-stack 160 196 cfg-arc-src cfg-acc-arc)
(rule-h 12 280 296 (c-rule))
(var ss (cdr (cdr sl-src)))
(var cs (cdr (cdr sl-col)))
(looprange i 0 2 {
(var sc (ix ss i))
(if (!= sc 15) {
(var y (+ 300 (* i 84)))
(txt 16 (+ y 18) (ix cs i) font-sm (src-label sc))
(txt-r 304 (+ y 18) cfg-c-value font-md
(str-merge (src-fmt sc (src-dec sc)) " "
(src-unit sc)))
(box 16 (+ y 30) 288 2 (ix cs i))
})
})
})
(defun vp-dual () {
(txt-c 84 34 cfg-acc-tl font-sm "MOTOR 1")
(box 12 42 144 2 cfg-acc-tl)
(txt-c 236 34 cfg-acc-tr font-sm "MOTOR 2")
(box 164 42 144 2 cfg-acc-tr)
(var nm k-dualnm)
(looprange i 0 3 {
(var y (+ 68 (* i 84)))
(txt 12 y cfg-acc-tl font-sm (ix nm i))
(txt 12 (+ y 50) cfg-c-value font-lg
(src-fmt (cond ((= i 0) 1) ((= i 1) 2) (t 3)) 0))
(txt 164 y cfg-acc-tr font-sm (ix nm i))
(txt 164 (+ y 50) cfg-c-value font-lg
(src-fmt (cond ((= i 0) 16) ((= i 1) 17) (t 18)) 0))
})
(rule-h 12 330 296 (c-rule))
(med-stack 160 404 cfg-arc-src cfg-acc-arc)
})
(defun vp-flank () {
(if (!= cfg-tl-src 15)
(txt-cs 34 26 cfg-acc-tl font-sm (src-label cfg-tl-src)))
(meter-v 12 (+ 36 (strip-drop)) 40 (- 300 (strip-drop)) cfg-tl-src cfg-tl-min cfg-tl-max cfg-acc-tl 18)
(if (!= cfg-tr-src 15)
(txt-cs 286 26 cfg-acc-tr font-sm (src-label cfg-tr-src)))
(meter-v 268 (+ 36 (strip-drop)) 40 (- 300 (strip-drop)) cfg-tr-src cfg-tr-min cfg-tr-max cfg-acc-tr 18)
(med-stack 160 (+ 180 (strip-drop)) cfg-arc-src cfg-acc-arc)
(rule-h 70 352 180 (c-rule))
(if (!= cfg-bl-src 15) {
(txt-c 160 382 cfg-acc-bl font-sm (src-label cfg-bl-src))
(txt-c 160 418 cfg-c-value font-md
(str-merge (src-fmt cfg-bl-src (src-dec cfg-bl-src)) " "
(src-unit cfg-bl-src)))
})
})
(defun vp-moto () {
(var pct (* d-soc 100.0))
(var ac (cond ((< pct 15.0) 0xFF0000) ((< pct 35.0) 0xFFFF00)
(t cfg-acc-batt)))
(var lit (to-i (* 12 (clamp01 (/ pct 100.0)))))
(looprange i 0 12
(if (< i lit)
(rbox 12 (- 316 (* i 25)) 54 21 3 ac)
(rframe 12 (- 316 (* i 25)) 54 21 3 0x184018 1)))
(txt-c 39 356 ac font-sm (str-merge (fmt pct 0) "%"))
(if (!= cfg-arc-src 15) {
(txt-c 196 86 cfg-acc-arc font-sm (src-unit cfg-arc-src))
(txt-c 196 192 cfg-c-value font-xl
(src-fmt cfg-arc-src (src-dec cfg-arc-src)))
})
(var mc (mode-colour cfg-mode))
(rbox 238 296 66 66 8 mc)
(txt-c 271 348 0x000000 font-lg (mode-label cfg-mode))
(rule-h 12 382 296 (c-rule))
(var ss (cdr sl-src))
(var cs (cdr sl-col))
(looprange i 0 2 {
(var sc (ix ss i))
(if (!= sc 15) {
(var y (+ 416 (* i 52)))
(txt 16 y (ix cs i) font-sm (src-label sc))
(txt-r 304 y cfg-c-value font-md
(str-merge (src-fmt sc (src-dec sc)) " "
(src-unit sc)))
})
})
})
(defun sc-tri (cx cy sz up c) {
(var h (/ (* sz 3) 5))
(looprange i 0 h {
(var ww (/ (* sz i) h))
(var yy (if up (+ cy i) (- (+ cy h) i 1)))
(if (> ww 1) (box (- cx (/ ww 2)) yy ww 1 c))
})
})
(defun vp-scoobi () {
(var blink (< (mod (to-i (* (secs-since 0) 2.0)) 2) 1))
(if (and st-turn-l blink) (st-arrow 8 14 76 0x00FF00 true))
(if (and st-turn-r blink) (st-arrow 236 14 76 0x00FF00 false))
(if (= cfg-mode 0)
(txt-c 160 54 0xFFFF00 font-lg "N")
(sc-tri 160 18 56 (!= cfg-mode -1)
(if (= cfg-mode -1) 0xFF8000 0x00A0FF)))
(if (!= cfg-arc-src 15) {
(txt-c 160 88 0xFFFFFF font-md (str-to-lower (src-unit cfg-arc-src)))
(var value (src-fmt cfg-arc-src (src-dec cfg-arc-src)))
(var wide (> (ix (tdim-k font-xl value) 0) 288))
(txt-c 160 (if wide (base-c font-ring 195) 280) cfg-c-value
(if wide font-ring font-xl) value)
})
(var a d-amps)
(var lim (if (> cfg-bar-max 1.0) cfg-bar-max 100.0))
(var f (clamp01 (/ (abs a) lim)))
(var half (to-i (* 118.0 f)))
(box 155 305 10 8 0x0090FF)
(if (> half 5)
(if (< a 0.0)
(rbox (- 160 half) 303 (* half 2) 12 4 0x00FF40)
(rbox (- 160 half) 303 (* half 2) 12 4 0x0090FF)))
(txt-c 160 362 cfg-c-value font-lg (src-fmt 10 0))
(txt-c 160 394 cfg-c-dim font-sm (src-label 10))
(var pct (* d-soc 100.0))
(rframe 44 410 112 50 6 0xFFFFFF 3)
(box 156 424 8 22 0xFFFFFF)
(var fw (to-i (* 100.0 (clamp01 (/ pct 100.0)))))
(var bc (cond ((< pct 15.0) 0xFF0000) ((< pct 35.0) 0xFFFF00)
(t 0x0090FF)))
(if (> fw 4) (box 50 416 fw 38 bc) (tc-skip))
(box 174 425 20 6 cfg-c-value)
(box 174 437 20 6 cfg-c-value)
(txt-c 246 408 cfg-c-dim font-sm (src-label 9))
(txt-c 246 456 cfg-c-value font-lg (src-fmt 9 0))
})
(defun draw-vertical () (cond
((= cfg-vstyle 1) (vp-tacho))
((= cfg-vstyle 2) (vp-dual))
((= cfg-vstyle 3) (vp-flank))
((= cfg-vstyle 4) (vp-moto))
((= cfg-vstyle 5) (vp-scoobi))
((= cfg-vstyle 6) (draw-arc-v))
((= cfg-vstyle 7) (draw-free))
(t (vp-stack))))
(defun cell-colour (v) (cond
((< v 3.0) 0xFF0000)
((< v 3.4) 0xFFFF00)
((> v 4.15) 0xFF8000)
(t 0x00FF00)))
(defun draw-cells () {
(var mx (- fb-w 16))
(var mw (- fb-w 32))
(var wide (> fb-w 400))
(txt 16 32 cfg-acc-arc font-sm "CELLS")
(var cl bms-cells)
(var n (if (> bms-n 0) (length cl) 0))
(if (= n 0)
(txt 16 90 cfg-c-value font-md "no bms")
{
(var rows (if wide (if (> n 16) 2 1) (if (> n 20) 3 2)))
(var cols (/ (+ n rows -1) rows))
(var gap 3)
(var cw (/ (- mw (* (- cols 1) gap)) cols))
(var foot (if wide 62 96))
(var top 52)
(var rh (- (/ (- (- fb-h foot) top) rows) (if (> rows 1) 6 0)))
(var idx (>= cw 26))
(var barh (- rh (if idx 20 0)))
(var vmin 9.9) (var vmax 0.0)
(var imin 0) (var imax 0)
(var i 0)
(loopforeach v cl {
(if (< v vmin) { (setq vmin v) (setq imin i) })
(if (> v vmax) { (setq vmax v) (setq imax i) })
(setq i (+ i 1))
})
(txt-r mx 32 cfg-c-unit font-sm (str-from-n n "%dS"))
(rule-h 16 40 mw cfg-acc-arc)
(setq i 0)
(loopforeach v cl {
(var r (/ i cols))
(var c (mod i cols))
(var x (+ 16 (* c (+ cw gap))))
(var y (+ top (* r (+ rh 6))))
(var f (clamp01 (/ (- v 3.0) 1.2)))
(var h (to-i (* barh f)))
(var col (cell-colour v))
(if (= i imin) (setq col 0x00FFFF))
(if (= i imax) (setq col 0xFF8000))
(rbox x y (- cw 1) barh 2 0x141414)
(if (> h 3) (rbox x (+ y (- barh h)) (- cw 1) h 2 col))
(if idx
(txt-c (+ x (/ cw 2)) (+ y barh 17) cfg-c-dim font-sm
(str-from-n (+ i 1) "%d")))
(setq i (+ i 1))
})
(if wide {
(rule-h 16 (- fb-h 58) mw (c-rule))
(txt 16 (- fb-h 28) 0x00FFFF font-sm (str-from-n vmin "LOW %.3fV"))
(txt-c (/ fb-w 2) (- fb-h 28) cfg-c-value font-sm
(str-from-n (to-i (* (- vmax vmin) 1000.0)) "%d mV"))
(txt-r mx (- fb-h 28) 0xFF8000 font-sm (str-from-n vmax "HIGH %.3fV"))
(txt 16 (- fb-h 4) cfg-acc-tl font-sm
(str-merge (str-from-n (cv-temp bms-tmax) "PACK %.0f") (src-unit 8)))
(txt-r mx (- fb-h 4) cfg-acc-tr font-sm
(str-from-n bms-i "%.1f A"))
} {
(rule-h 16 (- fb-h 92) mw (c-rule))
(txt 16 (- fb-h 60) 0x00FFFF font-sm
(str-from-n vmin "LOW %.3fV"))
(txt-r mx (- fb-h 60) 0xFF8000 font-sm
(str-from-n vmax "HIGH %.3fV"))
(txt 16 (- fb-h 24) cfg-c-value font-sm
(str-from-n (to-i (* (- vmax vmin) 1000.0)) "%d mV"))
(txt-c (/ fb-w 2) (- fb-h 24) cfg-acc-tl font-sm
(str-merge (str-from-n (cv-temp bms-tmax) "PACK %.0f") (src-unit 8)))
(txt-r mx (- fb-h 24) cfg-acc-tr font-sm
(str-from-n bms-i "%.1f A"))
})
})
})
(defun charge-mins () {
(if (> bms-i 0.2)
(to-i (* 60.0 (/ (- bms-ahfull bms-ah) bms-i)))
0)
})
(defun cell-spread () {
(if (> bms-n 0) {
(var lo 9.9) (var hi 0.0)
(loopforeach v bms-cells {
(if (< v lo) (setq lo v))
(if (> v hi) (setq hi v)) })
(to-i (* (- hi lo) 1000.0))
} 0)
})
(defun draw-charging () {
(var pct (if (> bms-n 0) bms-soc (* d-soc 100.0)))
(var mg 16)
(var segs 22)
(var sgap 4)
(var sw (/ (- fb-w (* 2 mg) (* (- segs 1) sgap)) segs))
(var bary 54)
(var barh 26)
(var ruley (- fb-h 124))
(txt-c (/ fb-w 2) 34 0x00FF00 font-sm "CHARGING")
(var lit (to-i (* segs (clamp01 (/ pct 100.0)))))
(looprange i 0 segs
(rbox (+ mg (* i (+ sw sgap))) bary sw barh 3
(if (< i lit) 0x00FF00 (c-meter))))
(txt-c (/ fb-w 2) (base-c font-xl (/ (+ (+ bary barh 8) (- ruley 8)) 2))
cfg-c-value font-xl (str-merge (fmt pct 0) "%"))
(rule-h mg ruley (- fb-w (* 2 mg)) (c-rule))
(var m (charge-mins))
(var c1 (/ fb-w 6))
(var c2 (/ fb-w 2))
(var c3 (- fb-w (/ fb-w 6)))
(var r1l (+ ruley 26)) (var r1v (+ ruley 54))
(var r2l (+ ruley 86)) (var r2v (+ ruley 114))
(txt-c c1 r1l cfg-acc-tl font-sm "TIME LEFT")
(txt-c c1 r1v cfg-c-value font-sm
(if (> m 0) (str-merge (str-from-n (/ m 60) "%dh ")
(str-from-n (mod m 60) "%02dm")) "--"))
(txt-c c2 r1l cfg-acc-tr font-sm "CURRENT")
(txt-c c2 r1v cfg-c-value font-sm (str-from-n bms-i "%.1f A"))
(txt-c c3 r1l cfg-acc-br font-sm "PACK")
(txt-c c3 r1v cfg-c-value font-sm
(str-merge (str-from-n (if (> bms-v 0.0) bms-v d-volt) "%.1f") "V"))
(txt-c c1 r2l cfg-acc-bl font-sm "CELL DIFF")
(txt-c c1 r2v cfg-c-value font-sm
(if (> bms-n 0) (str-from-n (cell-spread) "%d mV") "--"))
(txt-c c2 r2l cfg-acc-tl font-sm "PACK TEMP")
(txt-c c2 r2v cfg-c-value font-sm
(if (> bms-n 0)
(str-merge (str-from-n (cv-temp bms-tmax) "%.0f")
(if (= cfg-unit-temp 1) "C" "F"))
"--"))
(txt-c c3 r2l cfg-acc-tr font-sm "CHARGED")
(txt-c c3 r2v cfg-c-value font-sm
(if (> bms-ahfull 0.0)
(str-merge (str-from-n bms-ah "%.1f") "Ah")
"--"))
})
(defun draw-frame () {
(if (or fb-hold (eq fb nil) (not fonts-ready)) (sleep 0.1)
{
(def fb-drawing true)
(if slide-req (slide-take))
(if ble-pick { (draw-ble) (fb-flush) (fb-redraw) }
(if quick-open { (draw-quick) (fb-flush) (fb-redraw) }
(draw-frame-inner)))
(def fb-drawing false)
})
})
(def ov-prev nil)
(defun ov-state () (list
(if (and cfg-simple (not (cart-package-live))) 1 0)
(if (strip-on) 1 0)
(if sig-left 1 0) (if sig-right 1 0)
(if sig-hazard 1 0) (if sig-beam 1 0)
cfg-mode
(if (gear-locked (- cfg-mode 1)) 1 0)
(if (< (secs-since mode-blocked) 1.5) 1 0)
(if (and (not d-online) (< (mod (to-i (* (secs-since 0) 2.0)) 2) 1)) 1 0)
(if (ble-offer) (ble-offer-message) nil)
(if walk-on 1 0)
(if (and cfg-auto-charge (bms-chg)) 1 0)
page
(ix (strip-slot) 1)
(ix (chip-slot) 1)
(if st-turn-l 1 0) (if st-turn-r 1 0) (if st-beam 1 0) (if st-brake 1 0)
d-fault
(if (and (not (tc-layout)) (or st-turn-l st-turn-r sig-left sig-right sig-hazard))
(mod (to-i (* (secs-since 0) 2.0)) 2) 0)))
(defun fb-incremental () (and (not walk-on) (or (help-active) (not (ble-offer)))))
(defun tc-layout ()
(and (not (and (= page (pg-setup)) (>= setup-view 5)))
(not (and (= page 0) (not cfg-vertical) (= cfg-style 6)
(not (and cfg-auto-charge (bms-chg)))))))
(defun draw-layout ()
(if (and cfg-auto-charge (bms-chg))
(draw-charging)
(if (= page 0)
(if cfg-vertical
(draw-vertical)
(cond
((= cfg-style 1) (draw-twin))
((= cfg-style 2) (draw-dual))
((= cfg-style 3) (draw-tacho))
((= cfg-style 4) (draw-flank))
((= cfg-style 5) (draw-header))
((= cfg-style 6) (draw-arc))
((= cfg-style 7) (draw-free))
(t (draw-instrument))))
(if (= page (pg-ride))
(if cfg-vertical (draw-vpage2) (draw-page2))
(if (= page (pg-cells))
(draw-cells)
(if (= page (pg-whl))
(draw-whl)
(if (= page (pg-setup)) (draw-setup) (draw-quick))))))))
(defun paint-full () {
(img-clear fb theme-bg)
(def tc-mode (if (tc-layout) 1 0))
(def tc-i 0)
(def tc-acc nil)
(def tb-acc nil)
(def tb-seen 0)
(draw-layout)
(draw-overlays)
(if (= tc-mode 1) {
(def tc-rec (reverse tc-acc))
(def tc-n (length tc-rec))
(def tc-bx (map tc-box tc-rec))
(def tb-rec (reverse tb-acc))
(def tb-n (length tb-rec))
(def tb-acc nil)
(def tc-acc nil)
})
(def tc-mode 0)
})
(def disp-sig-last nil)
(defun q100 (v) (to-i (* 100.0 v)))
(defun page-idle-sig () (if (and cfg-auto-charge (bms-chg)) nil (cond
((help-active) (help-draw-sig))
((and (= page (pg-setup)) (>= setup-view 8)) (basic-draw-sig))
((and (= page (pg-setup)) (>= setup-view 5)) (imu-draw-sig))
((and (= page (pg-setup)) (= setup-view 0))
(list 'setup-hub (setup-locked) (hall-locked) (setup-live)))
((= page (pg-set)) (list 'quick bl-night-on (bl-level) cfg-ab-en
cfg-unit-temp cfg-unit-speed))
((= page (pg-whl)) (whl-draw-sig))
(t nil))))
(def disp-cfg-last nil)
(defun disp-cfg () (list
cfg-vertical cfg-style cfg-vstyle theme-bg theme-acc slots-sig sl-min sl-max
cfg-c-value cfg-c-unit cfg-lbl-slot cfg-lbl-main cfg-icons cfg-unit-speed
cfg-unit-temp cfg-unit-dist cfg-fs-sm cfg-fs-lg cfg-fs-xl cfg-fs-ring cfg-font
cfg-aa cfg-icon-size cfg-bar-fill (show-bits) d-online (bms-live) (e2-live)
(if (= page (pg-setup)) (list setup-view setup-choice hall-confirm (setup-locked) (hall-locked) imu-edit) nil)))
(defun disp-sig () (if (!= page 0) nil (list
(map (fn (s) (q100 (src-val s))) sl-src)
(q100 (src-val cfg-bar-fill))
(map q100 (list d-amps d-duty d-soc d-tesc d-tmot d-volt
e2-amps e2-duty e2-tesc e2-tmot bms-soc))
bms-n (bms-live) (e2-live)
(if (or sig-left sig-right sig-hazard st-turn-l st-turn-r)
(mod (to-i (* (secs-since 0) 2.0)) 2) 0))))
(defun draw-frame-inner () {
(slots-check)
(page-keep)
(if (>= page (page-count)) (def page 0))
(if (or cfg-theme-all
(>= (if cfg-vertical cfg-vstyle cfg-style) 6))
(theme-set cfg-bg-col cfg-acc-col)
(theme-set 0x000000 0x000000))
(var ov (ov-state))
(var cfgs (disp-cfg))
(var entering (or fb-dirty (not-eq ov ov-prev) (not-eq cfgs disp-cfg-last)))
(def disp-cfg-last cfgs)
(def ov-prev ov)
(def fb-entering entering)
(def fb-dirty (not (fb-incremental)))
(def tc-bg theme-bg)
(var sig (page-idle-sig))
(if (not sig) (setq sig (if (tc-layout) (disp-sig) nil)))
(if entering {
(paint-full)
(def fb-changed true)
} (if (and sig (eq sig disp-sig-last))
(def fb-changed false)
(if (tc-layout) {
(def fb-changed false)
(def tc-mode 2)
(def tc-i 0)
(def tc-restart false)
(def tc-dmg nil)
(def tb-i 0)
(draw-layout)
(draw-overlays)
(def tc-mode 0)
(if (and (not tc-restart) tc-dmg) (tc-repair-all))
(if (or tc-restart (!= tc-i tc-n)) {
(def fb-entering true)
(paint-full)
(def fb-changed true)
})
} {
(def fb-changed true)
(draw-layout)
})))
(def disp-sig-last sig)
(if (or entering fb-dirty fb-changed) (fb-flush))
})
(defun draw-overlays () {
(var st-ok (and (not (and cfg-auto-charge (bms-chg)))
(!= page (pg-set))
(>= (ix (strip-slot) 1) 0)))
(if (and st-ok (or (strip-on) (> d-fault 0) (not d-online)))
(draw-status))
(if (and cfg-show-modestrip (= page 0) (not (bms-chg))
(>= (ix (chip-slot) 1) 0))
(draw-modestrip))
(if (and (not st-ok) (not d-online) (< (mod (to-i (* (secs-since 0) 2.0)) 2) 1))
(rbox (- fb-w 12) 4 8 8 4 0xFF0000))
(if (and (ble-offer) (!= page (pg-set)) (not (help-active))) (draw-ble-offer))
(if walk-on {
(var w 150) (var h 52)
(var bx (/ (- fb-w w) 2)) (var by (/ (- fb-h h) 2))
(rbox bx by w h 8 0x006000)
(rframe bx by w h 8 0x00E000 2)
(txt-c (/ fb-w 2) (base-c font-md (/ fb-h 2)) 0xFFFFFF font-md "WALK")
})
})
(defun bms-live () (and (> bms-n 0) (< (secs-since bms-last) 30.0)))
(defun pg-ride ()  (if cfg-show-page2 1 -1))
(defun pg-cells () (if (bms-live) (+ 1 (if cfg-show-page2 1 0)) -1))
(defun pg-whl ()   (if (whl-show) (+ 1 (if cfg-show-page2 1 0) (if (bms-live) 1 0)) -1))
(defun pg-setup () (+ 1 (if cfg-show-page2 1 0) (if (bms-live) 1 0) (if (whl-show) 1 0)))
(defun pg-hall () (pg-setup))
(defun pg-set () (+ 1 (pg-setup)))
(defun page-count () (+ 1 (pg-set)))
(def page-k 0)
(def page-set-sig nil)
(defun page-kind (p) (cond ((= p 0) 0) ((= p (pg-ride)) 1) ((= p (pg-cells)) 2)
((= p (pg-setup)) 6) ((= p (pg-whl)) 4) ((= p (pg-set)) 3) (t 0)))
(defun kind-page (k) (cond ((and (= k 1) (>= (pg-ride) 0)) (pg-ride))
((and (= k 2) (>= (pg-cells) 0)) (pg-cells))
((and (= k 4) (>= (pg-whl) 0)) (pg-whl))
((= k 5) (pg-hall))
((= k 6) (pg-setup))
((= k 3) (pg-set))
(t 0)))
(defun page-keep () {
(var sig (list cfg-show-page2 (bms-live) (whl-show)))
(if (not-eq sig page-set-sig) {
(if page-set-sig (def page (kind-page page-k)))
(def page-set-sig sig)
})
(def page-k (page-kind page))
})
(defun bms-chg () (and bms-charging (bms-live)))
(defun map-touch (tp) {
(var a (to-i (ix tp 0)))
(var b (to-i (ix tp 1)))
(if cfg-vertical
(if (= cfg-orient 1)
(list (- 320 a) (- 480 b))
(list a b))
(if (= cfg-orient 1)
(list b (- 320 a))
(list (- 480 b) a)))
})
@const-end
