@const-start
(def quick-open false)
(defun q-mg () 16)
(defun q-top () 84)
(defun q-bary () 46)
(defun q-barh () 20)
(defun q-gap () 12)
(defun q-bw () (/ (- fb-w (* 2 (q-mg)) (q-gap)) 2))
(defun q-bh () (/ (- fb-h (q-top) 16 (* 3 (q-gap))) 4))
(defun q-x (i) (+ (q-mg) (* (mod i 2) (+ (q-bw) (q-gap)))))
(defun q-y (i) (+ (q-top) (* (/ i 2) (+ (q-bh) (q-gap)))))
(defun q-half-w () (/ (- (q-bw) 6) 2))
(defun q-half-x () (+ (q-x 4) (q-half-w) 6))
(defun q-label (i) (cond
((= i 0) "DIMMER")
((= i 1) "BRIGHTER")
((= i 2) (if cfg-ab-en "BMS ON" "BMS OFF"))
((= i 3) "CONTROLLER")
((= i 4) "UNITS")
((= i 5) "POWER MODES")
((= i 6) "HOME") (t "CLOSE")))
(defun bl-level () (clamp01f (if bl-night-on cfg-bl-night cfg-bl-day)))
(defun q-lab2 (cx cy w s) {
(var sp (str-find s " "))
(if (or (< sp 0) (<= (+ (ix (tdim-k font-ui (str-clean s)) 0) 10) w))
(txt-c cx (base-c font-ui cy) 0xFFFFFF font-ui s)
{
(var lh (line-h font-ui))
(txt-c cx (base-c font-ui (- cy (/ lh 2))) 0xFFFFFF font-ui (str-part s 0 sp))
(txt-c cx (base-c font-ui (+ cy (/ lh 2))) 0xFFFFFF font-ui (str-part s (+ sp 1)))
})
})
(defun draw-quick-menu () {
(if (!= tc-mode 2) (img-clear fb theme-bg))
(txt-c (/ fb-w 2) (base-c font-ui 26) 0xFFFFFF font-ui
(if bl-night-on "QUICK SETTINGS - NIGHT" "QUICK SETTINGS"))
(var bw (- fb-w (* 2 (q-mg))))
(rbox (q-mg) (q-bary) bw (q-barh) 6 (c-meter))
(var lit (to-i (* (to-float bw) (bl-level))))
(if (> lit 8) (rbox (q-mg) (q-bary) lit (q-barh) 6 0x00A0FF) (tc-skip))
(looprange i 0 8 {
(var x (q-x i)) (var y (q-y i))
(var ty (base-c font-ui (+ y (/ (q-bh) 2))))
(if (= i 4)
{
(var hw (q-half-w))
(rbox x y hw (q-bh) 8 0x14181E)
(rbox (q-half-x) y hw (q-bh) 8 0x14181E)
(q-lab2 (+ x (/ hw 2)) (+ y (/ (q-bh) 2)) hw
(if (= cfg-unit-temp 1) "TEMP C" "TEMP F"))
(q-lab2 (+ (q-half-x) (/ hw 2)) (+ y (/ (q-bh) 2)) hw
(if (= cfg-unit-speed 1) "SPEED KPH" "SPEED MPH"))
}
{
(rbox x y (q-bw) (q-bh) 8
(if (= i 7) 0x3A1A1A
(if (and (= i 2) cfg-ab-en) 0x1A3A1A 0x14181E)))
(q-lab2 (+ x (/ (q-bw) 2)) (+ y (/ (q-bh) 2)) (q-bw) (q-label i))
})
})
})
(defun q-leave () (if quick-open (def quick-open false) (def page 0)))
(defun quick-menu-hit (x y) {
(var hit -1)
(looprange i 0 8 {
(if (and (>= x (q-x i)) (< x (+ (q-x i) (q-bw)))
(>= y (q-y i)) (< y (+ (q-y i) (q-bh))))
(setq hit i))
})
(cond
((= hit 0) (btn-action 18))
((= hit 1) (btn-action 17))
((= hit 2) {
(btn-action 23)
(if (and cfg-ab-en (< (abs d-speed) cfg-mode-lock))
(ab-open))
})
((= hit 3) { (q-leave) (btn-action 21) })
((= hit 4) (if (< x (q-half-x))
{
(def cfg-unit-temp (if (= cfg-unit-temp 1) 0 1))
(eeprom-store-i 17 cfg-unit-temp)
}
{
(def cfg-unit-speed (if (= cfg-unit-speed 1) 0 1))
(def cfg-unit-dist cfg-unit-speed)
(eeprom-store-i 16 cfg-unit-speed)
(eeprom-store-i 18 cfg-unit-dist)
}))
((= hit 5) (pm-open-page))
((= hit 6) { (def quick-open false) (def page 0) })
((= hit 7) (q-leave))
(t nil))
})
(defun whl-live () (< (secs-since whl-t) 2.0))
(defun whl-show () (if (not cfg-simple) (or (= cfg-whl-page 2) (and (= cfg-whl-page 1) whl-ever))))
(defun whl-att-live () (and whl-att-ok (= whl-att-via whl-via)
(> whl-att-t 0) (< (secs-since whl-att-t) 2.0)))
(defun whl-roll-live () (and (whl-live) (whl-att-live) (> whl-src 0)))
(defun whl-pitch-live () (and (whl-live)
(if (whl-att-live) (> whl-src 0) (not (whl-flag 32)))))
(defun whl-armed () (= (bitwise-and whl-flags 1) 1))
(defun whl-flag (b) (and (whl-live) (= (bitwise-and whl-flags b) b)))
(defun whl-from-link (data) (atomic {
(if (= (bufget-u8 data 65) 0x57) {
(def whl-pitch (/ (bufget-i16 data 67) 10.0))
(def whl-rate (/ (bufget-i16 data 69) 10.0))
(def whl-flags (bufget-u8 data 71))
(def whl-out (/ (bufget-i8 data 72) 100.0))
(def whl-t (systime))
(def whl-via 1)
(def whl-ever true)
})
(def whl-att-ok false)
(if (and (>= (buflen data) 113) (= (bufget-u8 data 105) 0x57)
(= (bufget-u8 data 106) 0x84) (= (bufget-u8 data 112) 1)
(<= (bufget-u8 data 111) 2)) {
(def whl-roll (/ (bufget-i16 data 107) 10.0))
(def whl-age (bufget-u16 data 109))
(def whl-src (bufget-u8 data 111))
(def whl-att-ok (and (>= whl-roll -180.0) (<= whl-roll 180.0)))
(def whl-att-via 1) (def whl-att-t (systime))
})
(if (= (bitwise-and (bufget-u8 data 73) 3) 3) {
(def whl-start (bufget-f32 data 74))
(def whl-end (bufget-f32 data 78))
(def whl-cfg-ok true)
})
}))
(defun whl-words (p) {
(var s (bufcreate (buflen p)))
(bufcpy s 0 p 1 (- (buflen p) 1))
(var w (str-split s " "))
(free s)
w
})
(def whl-rt-n 0)
(defun whl-from-ble (p) (cond
((and (= (bufget-u8 p 1) 114) (= (bufget-u8 p 2) 116)) {
(def whl-rt-n (+ whl-rt-n 1))
(if (or (= page (pg-whl)) (= (mod whl-rt-n 3) 0)) {
(var w (whl-words p))
(if (>= (length w) 18) {
(var num (fn (i) (str-to-f (ix w i))))
(def whl-pitch (num 1))
(def whl-rate (num 2))
(var armed (= (str-to-i (ix w 3)) 1))
(def whl-out (num 4))
(var eng (and armed (> (abs (- (num 5) whl-out)) 0.02)))
(def whl-flags (bitwise-or (if armed 1 0)
(bitwise-or (if eng 4 0)
(bitwise-or (if (= (str-to-i (ix w 11)) 1) 8 0)
(bitwise-or (if (= (str-to-i (ix w 17)) 1) 16 0)
(if (= (str-to-i (ix w 9)) 1) 32 0))))))
(def whl-t (systime))
(def whl-via 2)
(def whl-roll (num 10)) (def whl-src (str-to-i (ix w 6)))
(def whl-age (num 7))
(def whl-att-ok (and (>= whl-roll -180.0) (<= whl-roll 180.0)
(>= whl-src 0) (<= whl-src 2)))
(def whl-att-via 2) (def whl-att-t (systime))
(def whl-ever true)
(if (not whl-cfg-ok) (whl-ask))
})
})
})
((and (= (bufget-u8 p 1) 99) (= (bufget-u8 p 2) 111)) {
(var w (whl-words p))
(if (>= (length w) 22) {
(def whl-conf (map (fn (x) (str-to-f x)) (cdr w)))
(def whl-start (ix whl-conf 0))
(def whl-end (ix whl-conf 1))
(def whl-cfg-ok true)
})
})
(t nil)))
(defun whl-link (cmd arg f) (if (not cfg-simple) {
(var b (bufcreate 9))
(bufset-u8 b 0 0xC7) (bufset-u8 b 1 0x57) (bufset-u8 b 2 cmd)
(bufset-u8 b 3 arg) (bufset-u8 b 4 0)
(bufset-f32 b 5 f)
(link-send b)
(free b)
}))
(defun whl-ble (bytes) (if (not cfg-simple) {
(var b (bufcreate (+ (length bytes) 1)))
(bufset-u8 b 0 36)
(looprange i 0 (length bytes) (bufset-u8 b (+ i 1) (ix bytes i)))
(vb-send b)
(free b)
}))
(def whl-ask-t 0)
(defun whl-ask () (if (not cfg-simple) (if (> (secs-since whl-ask-t) 2.0) {
(def whl-ask-t (systime))
(if (= whl-via 1) (whl-link 1 0 0.0) (whl-ble '(1)))
})))
(defun whl-arm-toggle () (if (not cfg-simple) (if (and (not (hall-locked)) (not (setup-locked))) (whl-arm-toggle-inner))))
(defun whl-arm-toggle-inner () (if (not cfg-simple) (if (= whl-via 1) {
(var want (if (whl-armed) 0 1))
(whl-link 5 want 0.0)
(whl-link 5 want 0.0)
} (if (= whl-via 2) (whl-ble '(3))))))
(def whl-keep-t 0)
(defun whl-keep () (if (not cfg-simple) (if (and (!= cfg-whl-page 0) (not (link-carries))
(> (secs-since whl-keep-t) 1.0)) {
(def whl-keep-t (systime))
(whl-ble '(0))
})))
(defun whl-set (start end) (if (not cfg-simple) {
(def whl-start start) (def whl-end end)
(if (= whl-via 1) {
(whl-link 3 0 start)
(whl-link 3 1 end)
(whl-link 4 0 0.0)
(whl-link 4 0 0.0)
} (if (and (= whl-via 2) whl-conf) {
(var c whl-conf)
(var b (bufcreate 67))
(bufset-u8 b 0 36) (bufset-u8 b 1 2)
(bufset-f32 b 2 start) (bufset-f32 b 6 end)
(looprange i 2 6 (bufset-f32 b (+ 2 (* i 4)) (ix c i)))
(bufset-u8 b 26 (to-i (ix c 7))) (bufset-u8 b 27 (to-i (ix c 8)))
(bufset-f32 b 28 (ix c 9))
(bufset-f32 b 32 (ix c 10)) (bufset-f32 b 36 (ix c 11)) (bufset-f32 b 40 (ix c 12))
(bufset-u8 b 44 (to-i (ix c 13)))
(bufset-f32 b 45 (ix c 14))
(bufset-u8 b 49 (to-i (ix c 15)))
(bufset-u8 b 50 (if (< (ix c 16) 0.0) 255 (to-i (ix c 16))))
(bufset-f32 b 51 (ix c 17))
(bufset-f32 b 55 (ix c 18)) (bufset-f32 b 59 (ix c 19)) (bufset-f32 b 63 (ix c 20))
(vb-send b)
(free b)
(setix whl-conf 0 start) (setix whl-conf 1 end)
}))
}))
(defun w-mg () 12)
(defun w-chip-w () (if cfg-vertical 140 160))
(defun w-max () (if (> (+ whl-end 15.0) 60.0) (+ whl-end 15.0) 60.0))
(defun w-angle-font () (if (<= cfg-fs-lg 60) font-lg (if (<= cfg-fs-sm 30) font-md font-ui)))
(defun w-label-font () (if (<= cfg-fs-sm 18) font-sm font-ui))
(defun w-number-font () (if (<= cfg-fs-sm 22) font-md font-ui))
(defun w-angle-text (v) (str-from-n (if (< (abs v) 0.05) 0.0 v) "%.1f"))
(defun w-bh () 30)
(defun w-gw () (if cfg-vertical (- fb-w (* 2 (w-mg))) (/ (- fb-w (* 2 (w-mg)) 8) 2)))
(defun w-gx (g) (if cfg-vertical (w-mg) (+ (w-mg) (* g (+ (w-gw) 8)))))
(defun w-gy (g) (- fb-h (w-mg) (w-bh) (if cfg-vertical (* (- 1 g) (+ (w-bh) 6)) 0)))
(defun w-by () (- (w-gy 0) 4))
(defun w-plus (cx cy c) { (box (- cx 6) (- cy 1) 12 3 c) (box (- cx 1) (- cy 6) 3 12 c) })
(defun w-minus (cx cy c) (box (- cx 6) (- cy 1) 12 3 c))
(defun w-stat (cx y f label unit src) {
(txt-c cx (base-c font-ui y) 0x9AA0A8 font-ui
(if (eq label "") unit (str-merge label " " unit)))
(txt-c cx (base-c f (+ y 28)) (if d-online cfg-c-value 0x5A606A) f
(if d-online (src-fmt src 0) "--"))
})
(defun w-pill (x y w txtc s on col) {
(rbox x y w 28 8 (if on col 0x22262C))
(txt-c (+ x (/ w 2)) (base-c font-ui (+ y 14)) (if on txtc 0x5A606A) font-ui s)
})
(defun w-angle-card (x y w h label value known rollp) {
(rbox x y w h 12 0x14181E)
(txt-c (+ x (/ w 2)) (base-c font-ui (+ y 16)) 0x9AA0A8 font-ui label)
(var f (w-angle-font))
(txt-c (+ x (/ w 2)) (base-c f (+ y (if cfg-vertical 49 61)))
(if known 0xFFFFFF 0x5A606A) f (if known (w-angle-text value) "--"))
(var bx (+ x 16)) (var by (+ y h -12)) (var bw (- w 32))
(rbox bx by bw 4 2 (c-meter))
(if rollp {
(box (+ bx (/ bw 2)) (- by 3) 2 10 0x9AA0A8)
(if known {
(var at (to-i (+ bx (* bw (+ 0.5 (* 0.5 (/ (clampx value -90.0 90.0) 90.0)))))))
(rbox (- at 3) (- by 2) 6 8 3 (if (whl-flag 8) 0xEF4444 0x38BDF8))
})
} {
(if known {
(var filled (to-i (* bw (clamp01 (/ value (w-max))))))
(if (> filled 1) (rbox bx by filled 4 2
(cond ((< value whl-start) 0x22C55E) ((< value whl-end) 0xF59E0B) (t 0xEF4444))))
})
(if whl-cfg-ok {
(box (to-i (+ bx (* bw (clamp01 (/ whl-start (w-max)))))) (- by 3) 2 10 0xF59E0B)
(box (to-i (+ bx (* bw (clamp01 (/ whl-end (w-max)))))) (- by 3) 2 10 0xEF4444)
})
})
})
(defun whl-draw-sig () (list 'wheelie (whl-live) (whl-pitch-live) (whl-roll-live)
whl-flags whl-pitch whl-roll whl-cfg-ok whl-start whl-end d-online
(if d-online (list (src-fmt 0 0) (src-fmt 1 0) (src-fmt 2 0)) nil)))
(defun draw-whl () {
(if (!= tc-mode 2) (img-clear fb theme-bg))
(var live (whl-live))
(var label-font (w-label-font)) (var number-font (w-number-font))
(txt (w-mg) (base-c label-font 30) 0xFFFFFF label-font "WHEELIE")
(var ax (- fb-w (w-mg) (w-chip-w)))
(rbox ax 8 (w-chip-w) 44 10 (if (and live (whl-armed)) 0x15803D 0x3A3F47))
(txt-c (+ ax (/ (w-chip-w) 2)) (base-c label-font 30) 0xFFFFFF label-font
(if live (if (whl-armed) "ARMED" "DISARMED") "NO SIGNAL"))
(if cfg-vertical {
(w-angle-card 12 60 296 88 "PITCH DEG" whl-pitch (whl-pitch-live) false)
(w-angle-card 12 158 296 88 "ROLL DEG" whl-roll (whl-roll-live) true)
} {
(w-angle-card 12 60 224 108 "PITCH DEG" whl-pitch (whl-pitch-live) false)
(w-angle-card 244 60 224 108 "ROLL DEG" whl-roll (whl-roll-live) true)
})
(var sy (if cfg-vertical 264 184))
(w-stat (/ fb-w 6) sy number-font (if cfg-vertical "" "SPEED") (src-unit 0) 0)
(w-stat (/ fb-w 2) sy number-font "MOTOR" (src-unit 1) 1)
(w-stat (* fb-w (/ 5.0 6.0)) sy number-font "CTRL" (src-unit 2) 2)
(var cols (if cfg-vertical 2 4))
(var pw (/ (- fb-w (* 2 (w-mg)) (* (- cols 1) 8)) cols))
(var py (if cfg-vertical 318 234))
(var pill (fn (i label bit col tc)
(w-pill (+ (w-mg) (* (mod i cols) (+ pw 8))) (+ py (* (/ i cols) 36)) pw tc label (whl-flag bit) col)))
(pill 0 "CONTROL" 4 0x38BDF8 0x001A33)
(pill 1 "BRAKE" 16 0xF87171 0x330000)
(pill 2 "CUTOFF" 8 0xEF4444 0x330000)
(pill 3 "IMU LOST" 32 0xF59E0B 0x332200)
(looprange g 0 2 {
(var x (w-gx g)) (var y (w-gy g)) (var w (w-gw))
(var my (+ y (/ (w-bh) 2)))
(rbox x y w (w-bh) 8 0x14181E)
(txt (+ x 10) (base-c label-font my) (if (= g 0) 0xF59E0B 0xEF4444) label-font
(if (= g 0) "START" "CEILING"))
(rbox (+ x w -104) (+ y 2) 32 26 6 0x2A2F37)
(w-minus (+ x w -88) my 0xFFFFFF)
(txt-c (+ x w -53) (base-c number-font my) 0xFFFFFF number-font
(if whl-cfg-ok (str-from-n (if (= g 0) whl-start whl-end) "%.0f") "-"))
(rbox (+ x w -34) (+ y 2) 32 26 6 0x2A2F37)
(w-plus (+ x w -18) my 0xFFFFFF)
})
})
(defun whl-hit (x y) (if (not cfg-simple) {
(cond
((and (>= x (- fb-w (w-mg) (w-chip-w))) (< y 56) (whl-live))
(whl-arm-toggle))
((and (>= y (w-by)) whl-cfg-ok) {
(var hit -1)
(looprange g 0 2 {
(var gx (w-gx g)) (var gy (w-gy g)) (var w (w-gw))
(if (and (>= y (- gy 4)) (< y (+ gy (w-bh) 4))) {
(if (and (>= x (+ gx w -110)) (< x (+ gx w -68))) (setq hit (* g 2)))
(if (and (>= x (+ gx w -40)) (< x (+ gx w 4)))
(setq hit (+ (* g 2) 1)))
})
})
(var s whl-start) (var e whl-end)
(cond ((= hit 0) (setq s (- s 1.0))) ((= hit 1) (setq s (+ s 1.0)))
((= hit 2) (setq e (- e 1.0))) ((= hit 3) (setq e (+ e 1.0))))
(if (< s 0.0) (setq s 0.0))
(if (> e 75.0) (setq e 75.0))
(if (< e (+ s 5.0)) (if (< hit 2) (setq s (- e 5.0)) (setq e (+ s 5.0))))
(if (>= hit 0) (whl-set s e))
})
(t nil))
}))
@const-end
@const-start
(defun draw-quick () (if pm-open (draw-power-modes) (draw-quick-menu)))
(defun quick-hit (x y) (if pm-open (pm-hit x y) (quick-menu-hit x y)))
@const-end
