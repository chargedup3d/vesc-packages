@const-start
(defun link-dash-ok (data) (if (< (buflen data) 105) true {
(if (not scr-mac) (def scr-mac (get-mac-addr)))
(var none true) (var me true)
(looprange i 0 6 {
(var v (bufget-u8 data (+ 99 i)))
(if (!= v 0) (setq none false))
(if (!= v (ix scr-mac i)) (setq me false))
})
(or none me)
}))
(defun proc-frame (data) {
(if (and (>= (buflen data) 32) (= (bufget-u8 data 0) 0xCD)) {
(def link-mine (link-dash-ok data))
(def gw-link-target (if (and (>= (buflen data) 115) (= (bufget-u8 data 113) 0xD7))
(bufget-u8 data 114) -1))
(var on (!= 0 (bitwise-and (bufget-u8 data 1) 1)))
(if on {
(if (> (secs-since link-on-t) 2.0) (def link-on-t0 (systime)))
(def d-last (systime)) (def link-on-t (systime)) })
(if on {
(def d-speed (/ (bufget-i16 data 2) 10.0))
(def d-amps  (/ (bufget-i16 data 4) 10.0))
(def d-volt  (/ (bufget-u16 data 6) 10.0))
(def d-tmot  (/ (bufget-i16 data 8) 10.0))
(def d-tesc  (/ (bufget-i16 data 10) 10.0))
(if (not (bms-live)) (def d-tbat (/ (bufget-i16 data 12) 10.0)))
(def d-soc   (/ (bufget-u16 data 14) 1000.0))
(def d-kw    (/ (bufget-i16 data 16) 100.0))
(def d-duty  (/ (bufget-i16 data 18) 1000.0))
(if (>= (buflen data) 56)
(def d-iin (/ (bufget-i16 data 54) 10.0)))
(trip-in (/ (bufget-u16 data 20) 10.0))
(def d-odo   (/ (bufget-u32 data 22) 10.0))
(def d-wh    (/ (bufget-u16 data 26) 10.0))
(def d-fault (bufget-u16 data 28))
})
(var fl (bufget-u8 data 1))
(def st-turn-l (!= 0 (bitwise-and fl 8)))
(def st-turn-r (!= 0 (bitwise-and fl 16)))
(def st-beam   (!= 0 (bitwise-and fl 32)))
(if (and (not link-peer) link-saved)
(if (eq (car (trap (esp-now-add-peer link-mac))) 'exit-ok)
{ (def link-peer true)
(print (list "link at" link-mac))
(if kid-known (spawn kid-send)) }))
(if (and on (>= (buflen data) 48)) {
(def x-cruise (bufget-u8 data 40))
(def x-cruise-t (systime))
(def x-live (= (bufget-u8 data 41) 1))
(def x-pitch (/ (bufget-i16 data 42) 100.0))
(def x-amp-max (/ (bufget-u16 data 44) 10.0))
(def x-wh-chg (/ (bufget-u16 data 46) 10.0))
})
(if (and (>= (buflen data) 61) (= (bufget-u8 data 56) 1))
(esc-status (bufget-u8 data 57) (bufget-u8 data 58)
(bufget-u8 data 59)))
(if (and (>= (buflen data) 65)
(= (bitwise-and (bufget-u8 data 61) 0x80) 0x80)) {
(if (> (secs-since io-sw-t) 3.0) { (def io-seen false) (def io-ev-last -1) })
(def io-rev (= (bitwise-and (bufget-u8 data 61) 1) 1))
(def io-sw-t (systime))
(var code (bufget-u8 data 63))
(var seq (bufget-u8 data 62))
(if (and io-seen (> code 0) (!= seq io-ev-last))
(trap (io-run code (bufget-u8 data 64))))
(if (> code 0) (def io-ev-last seq))
(def io-seen true)
})
(if (>= (buflen data) 98) (whl-from-link data))
(hall-from-link data)
(setup-from-link data) (pm-receive data 185 1)
(if (and on (>= (buflen data) 40) (!= (bitwise-and fl 2) 0)) {
(def e2-last (systime))
(def e2-tmot (/ (bufget-i16 data 32) 10.0))
(def e2-tesc (/ (bufget-i16 data 34) 10.0))
(def e2-amps (/ (bufget-i16 data 36) 10.0))
(def e2-duty (/ (bufget-i16 data 38) 1000.0))
})
})
})
(defun proc-eid2 (vid cmd data) {
(if (>= (buflen data) 8) {
(cond
((= cmd 9) { (def e2-amps (/ (bufget-i16 data 4) 10.0))
(def e2-duty (/ (bufget-i16 data 6) 1000.0)) })
((= cmd 15) (def e2-wh (/ (bufget-i32 data 0) 10000.0)))
((= cmd 16) { (def e2-last (systime))
(def e2-tesc (/ (bufget-i16 data 0) 10.0))
(def e2-tmot (/ (bufget-i16 data 2) 10.0)) }))        })
})
(defun proc-eid (id data) {
(if (>= (buflen data) 8) {
(var vid2 (bitwise-and id 0xFF))
(if (and cfg-esc2-en (= vid2 cfg-esc2-id))
(proc-eid2 vid2 (shr id 8) data))
(if (= (bitwise-and id 0xFF) cfg-esc-id) {
(def d-last (systime))
(var cmd (shr id 8))
(cond
((= cmd 9) { (def d-amps (/ (bufget-i16 data 4) 10.0))
(def d-duty (/ (bufget-i16 data 6) 1000.0)) })
((= cmd 14) (def d-ah (/ (bufget-i32 data 0) 10000.0)))
((= cmd 15) (def d-wh (/ (bufget-i32 data 0) 10000.0)))
((= cmd 16) { (def d-tesc (/ (bufget-i16 data 0) 10.0))
(def d-tmot (/ (bufget-i16 data 2) 10.0))
(def d-iin (/ (bufget-i16 data 4) 10.0))
(def d-kw (/ (* d-volt d-iin) 1000.0)) })
((= cmd 27) (def d-volt (/ (bufget-i16 data 4) 10.0))))
})
})
(free data)
})
(def link-saved false)
(def link-nopair false)
(def link-cand nil)
(def link-cand-t 0)
(def link-rssi 0)
(def scr-mac nil)
(defun link-accept (src rssi data) (cond
(link-saved (if (eq src link-mac) { (def link-rssi rssi) true } false))
((or link-nopair (< (buflen data) 54) (!= (bufget-u8 data 0) 0xCD)
(not (link-dash-ok data))) false)
(t {
(if (not (eq src link-cand)) {
(def link-cand src)
(def link-cand-t (systime))
})
(def link-rssi rssi)
(if (or (>= rssi -60)
(and (> (secs-since link-cand-t) 20.0)
(not (and vb-linked (< (secs-since vb-last) 2.0)))))
(link-pair src))
link-saved
})))
(defun link-pair (m) {
(def link-mac m)
(def link-saved true)
(def link-peer false)
(eeprom-store-i 160 (+ 0x1000000 (* (ix m 0) 65536) (* (ix m 1) 256) (ix m 2)))
(eeprom-store-i 161 (+ 0x1000000 (* (ix m 3) 65536) (* (ix m 4) 256) (ix m 5)))
(print (list "paired with link" m))
})
(defun link-load () {
(var a (eeprom-read-i 160))
(var b (eeprom-read-i 161))
(if (and a b (>= a 0x1000000) (< a 0x2000000) (>= b 0x1000000) (< b 0x2000000)) {
(def link-mac (map to-i (list (bitwise-and (shr a 16) 255) (bitwise-and (shr a 8) 255)
(bitwise-and a 255) (bitwise-and (shr b 16) 255)
(bitwise-and (shr b 8) 255) (bitwise-and b 255))))
(def link-saved true)
(trap (esp-now-add-peer link-mac))
true
} false)
})
(defun link-forget () {
(def link-saved false)
(def link-peer false)
(def link-cand nil)
(eeprom-store-i 160 0)
(eeprom-store-i 161 0)
true
})
(defun link-forget-hold () { (def link-nopair true) (link-forget) })
(defun link-info () (print (list "link" (if link-saved link-mac "not paired")
"present" link-peer "rssi" link-rssi)))
(defun link-send (b) (if link-saved (esp-send link-mac b) '(not-paired)))
(def ev-errs 0)
(def ev-err nil)
(defun ev-check (r)
(if (not-eq (car r) 'exit-ok) {
(def ev-errs (+ ev-errs 1))
(def ev-err r)
}))
(defun event-handler ()
(loopwhile t
(recv
((event-esp-now-rx (? src) (? des) (? data) (? rssi)) {
(ev-check (trap (if (and (> (buflen data) 0) (= (bufget-u8 data 0) 0xD7))
(gw-radio src data)
(if (link-accept src rssi data) (proc-frame data)))))
(free data) })
((event-can-eid . ((? id) . (? data))) (ev-check (trap (proc-eid id data))))
(_ nil))))
(defun trip-in (raw) {
(def trip-raw raw)
(if (< raw trip-base) { (def trip-base 0.0) (def wh-base 0.0) })
(if (< d-wh wh-base) (def wh-base 0.0))
(def d-trip (- raw trip-base))
})
(defun trip-reset () { (def trip-base trip-raw) (def wh-base d-wh) (def d-trip 0.0) })
(defun trip-wh () (- d-wh wh-base))
(defun poll () {
(def d-online (< (secs-since d-last) 2.0))
(if (> d-trip 0.1) (def d-whkm (/ (trip-wh) d-trip)))
})
@const-end
